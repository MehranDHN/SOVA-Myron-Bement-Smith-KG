kg:note_ref24602_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref24602_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - Additional information reads, \"IN-372; IN-388; IN-376; IN-376; IN-390; IN-390; IN-390.\"" ;
