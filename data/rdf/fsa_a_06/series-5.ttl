kg:component_ref9823 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1164: Pasargadae. Tomb of Cyrus. Plan. IAE, fig.325" ;
    dct:identifier "FSA A.06 05.1164" ;
    crm:P102_has_title kg:title_ref9823 ;
    crm:P129_is_about kg:concept_aat_300263552,
