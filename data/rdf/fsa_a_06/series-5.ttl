kg:component_ref24878 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1398: Baalbeck (Lebanon): Qubbat as-Saadin: Annotated Sketch of the Facade" ;
    dct:identifier "FSA A.06 05.1398" ;
    dct:language "ger" ;
    crm:P102_has_title kg:title_ref24878 ;
    crm:P129_is_about kg:concept_aat_300263552,
        kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_lcsh_sh85006507 ;
    crm:P1_is_identified_by kg:title_ref24878 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Date/Time and Place of an Event Note As early as 1893, Ernst Herzfeld, Moritz Sobernheim, Max Freiherr von Oppenheim participated in Max Van Berchem's project to create a Corpus Inscriptionum Arabicarum. During the following 25 years, research materials such as glass negatives, photographic prints, drawings, maps, and notebooks were exchanged between the four archaeologists. In the case of this glass negative, it may have been taken by Moritz Sobernheim on a visit to Baalbeck between 1899 and 1905, as mentioned in his 1922 publication, \"Baalbek in Islamischer Zeit, in Voradruck aus dem Werke: Baalbek, Ergebnisse der Aus rabungen und Unterschungen in den Jahren 1898 bis 1905, Vol. 3.\"",
        "Local Numbers D-1398 FSA A.06 05.1398",
        "Scope and Contents Additional information from staff reads, \"Under the Ayyubids (1175-1250) and the Mamluks (1279-1516), Baalbek witnessed a revival of its political and economic role. To defend the city from crusader attacks, the Ayyubids built a citadel on the site of the temples of Jupiter and Bacchus, which continued to be used during the Mamluk period. Of this citadel and the town that existed within, the fortification wall, a gate, the towers and a mosque remain. Outside the fortified citadel, the old Shiite Mosque, the great and the small Ras al-Ain Mosques, Qubbat al-Amjad, Qubbat Douris and Qubbat as-Saadin were constructed.\"" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref24878 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:agent_sobernheim_moritz,
        kg:note_ref24878_arrangement_0,
        kg:note_ref24878_odd_0,
        kg:note_ref24878_odd_1,
        kg:note_ref24878_scopecontent_0,
        kg:place_balabakk_lebanon,
        kg:place_lebanon_beqaa_baalbek,
        kg:place_tgn_1000004,
        kg:place_tgn_1000126 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref24878> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc31f48098a-e62a-4230-a9cc-3c750fc64072> ;
    mbs:archivalLevel "item" ;
    mbs:digitizationKind mbs:ids_image ;
    mbs:digitized true ;
    mbs:eadRef "ref24878" ;
    mbs:hasDigitalObject kg:digital_fs_fsa_a_06_05_1398 ;
    mbs:hasLinguisticObject kg:note_ref24878_arrangement_0,
