        kg:place_mesopotamia,
        kg:place_samarra_iraq,
        kg:place_tgn_1000004,
        kg:place_tgn_1000118 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref24601> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3f622308a-0ac9-4b13-80ac-5370ca2195d8> ;
