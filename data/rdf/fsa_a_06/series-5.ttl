    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Excavation of Samarra (Iraq): Great Mosque of al-Mutawakkil, Reconstruction of the Mihrab: Ground Plan, Elevation and Section [drawing]" ;
    mbs:noteType mbs:ScopeContent .

