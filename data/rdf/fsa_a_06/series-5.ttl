    crm:P148_has_component kg:note_ref24320_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:fre ;
    rdf:value "Scope and Contents Original caption in French reads, \"Alep. Grande Mosquée.\"" ;
    mbs:noteType mbs:ScopeContent .

