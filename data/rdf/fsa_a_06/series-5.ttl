    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Excavation of Samarra (Iraq): Balkuwara: General Plan of the Complex with Outer Enclosure and Palace [drawing]" ;
    mbs:noteType mbs:ScopeContent .

