        kg:place_mesopotamia,
        kg:place_samarra_iraq,
        kg:place_tgn_1000004,
        kg:place_tgn_1000118 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref24713> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3c675295a-0327-4102-8d5d-1f0aa2085136> ;
    mbs:archivalLevel "item" ;
