kg:component_ref8953 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-255: Damascus? Shaikh Muhassin. Inked plan" ;
    dct:identifier "FSA A.06 05.0255" ;
    crm:P102_has_title kg:title_ref8953 ;
    crm:P129_is_about kg:concept_aat_300007391,
        kg:concept_aat_300263552,
        kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_lcsh_sh85006507 ;
    crm:P1_is_identified_by kg:title_ref8953 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Date/Time and Place of an Event Note The monuments and inscriptions of Northern Syria were surveyed and collected between 1908 and 1914 by Moritz Sobernheim and Ernst Herzfeld as part of a broader project, sponsored by the Institut de France, that of Max van Berchem's \"Matériaux pour un Corpus Inscriptionum Arabicarum.\" The drawing may be related to this survey as well as additional expeditions to Damascus (Syria) carried out by Ernst Herzfeld as early as 1903 and as later as 1930.",
        "Local Numbers D-255 FSA A.06 05.0255",
        "Scope and Contents Damascus (Syria): Turbat al-Raihaniya (Raihan): Sketch of Dome Tambour [drawing]",
        "Scope and Contents Original caption on verso reads, \"Raihān.\"" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref8953 ;
    crm:P67_refers_to kg:agent_Q62933,
