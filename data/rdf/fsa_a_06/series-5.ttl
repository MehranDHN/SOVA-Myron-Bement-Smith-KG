kg:component_ref24931 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1401: Excavation of Pasargadae (Iran): Handwritten Note Related to Mausoleum of Cyrus the Great" ;
    dct:identifier "FSA A.06 05.1401" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref24931 ;
    crm:P129_is_about kg:concept_ancient_near_eastern_art,
        kg:concept_architectural_drawing,
        kg:concept_excavations_archaeology ;
    crm:P1_is_identified_by kg:title_ref24931 ;
    crm:P2_has_type aat:300033973,
        kg:concept_aat_300027200,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Date/Time and Place of an Event Note Ernst Herzfeld first visited the site of Pasargadae in November 1905 while on an expedition from Assur (Kalat Schergat, Iraq) to Shiraz (Iran). In mid-November 1923, he conducted a preleminary campaign, completing various measured plans and drawings. Finally, a four-week session of excavations in April and May 1928, funded by the Notgemeinschaft der Deutschen Wissenschaft, was carried out by Ernst Herzfeld, assisted by the architect Friedrich Krefter.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Ernst Herzfeld original drawing's caption and Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers D-1401 FSA A.06 05.1401" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref24931 ;
