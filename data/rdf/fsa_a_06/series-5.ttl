kg:component_ref9756 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1093: Samarra, marked \"unpublished\". Haus V, VI and VIa, marked \"from Sketchbook\"" ;
