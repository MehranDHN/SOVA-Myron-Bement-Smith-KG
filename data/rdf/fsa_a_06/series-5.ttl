    crm:P148_has_component kg:note_ref9798_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Excavation of Samarra (Iraq): Airplane Photographs Compiled by Survey Party, Mesopotamian Expedition Forces" ;
    mbs:noteType mbs:ScopeContent .

