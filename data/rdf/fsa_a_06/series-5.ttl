kg:note_ref24595_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref24595_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - Additional information reads, \"IN-450; IN-449; IN-450; IN-452; IN-450; IN-451.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref24595_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref24595_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - \"The five barrel-vaulted sardābs of the ground level of the gateway abutting the palace were the focus of Herzfeld's excavation activities. Of the five sardābs forming the substructure for the rooms on the second-storey platform, the central one was partially excavated in 1911. The rooms had been filled with debris in the late madieval period when the second storey was remodeled. Finds included not only carved stucco fragments but also lustre and molded wares and a large percentage of Raqqa-wares.\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003; p.108.\"]" ;
    mbs:noteType mbs:ScopeContent .

