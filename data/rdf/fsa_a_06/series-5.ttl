kg:component_ref24699 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1290: Excavation of Samarra (Iraq): Palace of the Caliph (Dar al-Khilafa, Jawsaq al-Khaqani, Bayt al-Khalifah): the Polo Maydan and the Racecourses" ;
    dct:identifier "FSA A.06 05.1290" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref24699 ;
    crm:P129_is_about kg:concept_aat_300263552,
        kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_excavations_archaeology,
        kg:concept_lcsh_sh85000061,
        kg:work_islamic_art_and_architecture_series ;
    crm:P1_is_identified_by kg:title_ref24699 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Date/Time and Place of an Event Note Drawings related primarly to the second campaign of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin in 1912-1913.",
        "General Title is provided by FSg Archives staff based on Alastair Northedge's publication, \"An Interpretation of the Palace of the Caliph at Samarra (Dar Al-Khilafa or Jawsaq Al-Khaqani). In Ars Orientalis, Vol. 23.\"",
        "Local Numbers D-1290 FSA A.06 05.1290",
        "Scope and Contents Additional information reads, \"At Sāmarrā' there are the remains of a number of 'Abbāsid walled tracks which appear to be racecourses. Ernst Herzfeld found one track in the course of the German expedition of 1911-13 to the 'Abbāsid capital at Sāmarrā', and the outline of two more became known from a series of maps of the Sāmarrā' district made by the Mesopotamian Expeditionary Force in 1917. Herzfeld published his first brief discussion of these courses in 1948 in his Geschichte der Stadt Samarra', and a further description was published posthumously in his Persian empire in 1968.\"[Northedge Alastair,1990): The Racecourses at Samarra; Bulletin of the School of Oriental and African Studies 53, p.31-56.]" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref24699 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref24699_arrangement_0,
        kg:note_ref24699_odd_0,
        kg:note_ref24699_odd_1,
        kg:note_ref24699_odd_2,
        kg:note_ref24699_scopecontent_0,
        kg:place_iraq_salah_ad_din_samarra_dar_al_khilafa,
        kg:place_mesopotamia,
        kg:place_samarra_iraq,
        kg:place_tgn_1000004,
        kg:place_tgn_1000118 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref24699> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc30922fe75-2a8b-4429-808b-81689c28d0ba> ;
    mbs:archivalLevel "item" ;
    mbs:digitizationKind mbs:ids_image ;
