    rdf:value "Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.35-57.\"" .

kg:note_ref9793_odd_0_p_0 a crm:E33_Linguistic_Object ;
    rdf:value "D-1134" .

kg:note_ref9793_odd_0_p_1 a crm:E33_Linguistic_Object ;
    rdf:value "FSA A.06 05.1134" .

kg:note_ref9793_odd_1_p_0 a crm:E33_Linguistic_Object ;
