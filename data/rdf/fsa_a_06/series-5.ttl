    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Paikuli (Iran), Ruins of the Sasanian Monument: Plaited Hair and Palmettes Attached to the Crown of King Narseh [drawing]" ;
    mbs:noteType mbs:ScopeContent .

