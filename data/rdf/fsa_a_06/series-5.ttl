kg:component_ref24785 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1470: Aleppo (Syria): Citadel: Ground Plan" ;
    dct:identifier "FSA A.06 05.1470" ;
    dct:language "fre" ;
    crm:P102_has_title kg:title_ref24785 ;
    crm:P129_is_about kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_lcsh_sh85006507 ;
    crm:P1_is_identified_by kg:title_ref24785 ;
    crm:P2_has_type aat:300034787,
        kg:concept_blueprints,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Date/Time and Place of an Event Note The monuments and inscriptions of Northern Syria were surveyed and collected between 1908 and 1914 by Moritz Sobernheim and Ernst Herzfeld as part of a broader project, sponsored by the Institut de France, that of Max van Berchem's \"Matériaux pour un Corpus Inscriptionum Arabicarum.\" The drawings are related to this survey as well as additional expeditions to Aleppo (Syria) carried out by Ernst Herzfeld in 1907, 1908, 1910, 1914, 1916, 1917, 1918, and 1930.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Ernst Herzfeld original drawings'caption and Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers D-1470 FSA A.06 05.1470",
        "Scope and Contents Original caption in French reads, \"Plan de la Citadelle d'Haleb. Levé et dessiné par Ernst Herzfeld, mai 1908, juin 1909.\"" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref24785 ;
    crm:P67_refers_to kg:agent_Q62933,
