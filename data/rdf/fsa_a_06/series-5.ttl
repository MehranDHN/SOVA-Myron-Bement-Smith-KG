        kg:note_ref9454_scopecontent_0,
        kg:note_ref9454_scopecontent_1,
        kg:note_ref9454_scopecontent_2,
        kg:note_ref9454_scopecontent_3,
        kg:place_iran_semnan_bistam,
        kg:place_tgn_1000004,
        kg:place_tgn_7000231 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref9454> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc305c65232-410a-4879-86ad-23e60a4063e3> ;
