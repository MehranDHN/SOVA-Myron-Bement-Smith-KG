kg:component_ref24776 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-802b: Excavation of Pasargadae (Iran): Terrace Mound of The Sacred Precinct: Isometric Plan of Ruins, probably drawn by Friedrich Krefter" ;
    dct:identifier "FSA A.06 05.0802b" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref24776 ;
    crm:P129_is_about kg:concept_aat_300263552,
