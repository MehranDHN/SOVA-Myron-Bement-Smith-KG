    crm:P72_has_language lang:und ;
    rdf:value "Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers." .

kg:note_ref24699_odd_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "D-1290" .

kg:note_ref24699_odd_0_p_1 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "FSA A.06 05.1290" .

kg:note_ref24699_odd_1_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "Title is provided by FSg Archives staff based on Alastair Northedge's publication, \"An Interpretation of the Palace of the Caliph at Samarra (Dar Al-Khilafa or Jawsaq Al-Khaqani). In Ars Orientalis, Vol. 23.\"" .

kg:note_ref24699_odd_2_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "Drawings related primarly to the second campaign of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin in 1912-1913." .

kg:note_ref24699_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "Additional information reads, \"At Sāmarrā' there are the remains of a number of 'Abbāsid walled tracks which appear to be racecourses. Ernst Herzfeld found one track in the course of the German expedition of 1911-13 to the 'Abbāsid capital at Sāmarrā', and the outline of two more became known from a series of maps of the Sāmarrā' district made by the Mesopotamian Expeditionary Force in 1917. Herzfeld published his first brief discussion of these courses in 1948 in his Geschichte der Stadt Samarra', and a further description was published posthumously in his Persian empire in 1968.\"[Northedge Alastair,1990): The Racecourses at Samarra; Bulletin of the School of Oriental and African Studies 53, p.31-56.]" .

