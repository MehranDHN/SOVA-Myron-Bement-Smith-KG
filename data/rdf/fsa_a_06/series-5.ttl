    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Baalbek (Lebanon): Fortified Walls of the Citadel: Transcription of Arabic Inscription No. I, in Kufic Script [drawing]" ;
    mbs:noteType mbs:ScopeContent .

