kg:note_ref9792_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9792_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Additional information reads, \"Abutting the center of the qibla wall, between tower 4 and 7, stretched a rectangular complex. Its ruins were investigated in early 1911 when Herzfeld cleared the area in front of what later turned out to be the back side of the miḥrāb of the congregational mosque. Of this building only the western half, situated between tower 4 and 5, was actually uncovered while the eastern half was reconstructed in Herzfeld's plan according to the results of exploration of the western side. These two wings might have flanked an open courtyard.\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003; p.52-53.\"]" ;
    mbs:noteType mbs:ScopeContent .

