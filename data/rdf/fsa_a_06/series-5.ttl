    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Excavation of Samarra (Iraq): Balkuwara Palace, Cruciform Reception-Hall Block and Courtyard III: Isometric Reconstruction [drawing]" ;
    mbs:noteType mbs:ScopeContent .

