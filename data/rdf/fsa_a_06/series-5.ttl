kg:component_ref9792 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1133: Samarra, Great mosque. Floor" ;
    dct:identifier "FSA A.06 05.1133" ;
    crm:P102_has_title kg:title_ref9792 ;
    crm:P129_is_about kg:concept_aat_300007391,
        kg:concept_aat_300263552,
        kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_excavations_archaeology,
        kg:concept_lcsh_sh85000061 ;
    crm:P1_is_identified_by kg:title_ref9792 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Bibliography Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.53, fig.29.\"",
        "Date/Time and Place of an Event Note Drawings related primarly to the first campaign of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin in 1911.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Thomas Leisten's publication, Excavation of Samarra, vol 1.",
        "Local Numbers D-1133 FSA A.06 05.1133",
        "Scope and Contents Additional information reads, \"Abutting the center of the qibla wall, between tower 4 and 7, stretched a rectangular complex. Its ruins were investigated in early 1911 when Herzfeld cleared the area in front of what later turned out to be the back side of the miḥrāb of the congregational mosque. Of this building only the western half, situated between tower 4 and 5, was actually uncovered while the eastern half was reconstructed in Herzfeld's plan according to the results of exploration of the western side. These two wings might have flanked an open courtyard.\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003; p.52-53.\"]",
        "Scope and Contents Excavation of Samarra (Iraq): Great Mosque of al-Mutawakkil, Dar al-Imara, the Southern Annex Building: Ground Plan [drawing]" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref9792 ;
    crm:P67_refers_to kg:agent_Q62933,
