    crm:P72_has_language lang:und ;
    rdf:value "Ernst Herzfeld: \"Altpersische Inschriften. Verlag von Dietrich Reimer/ Andrews & Steiner / Berlin, 1938. Pp. 2 and 23; Abb. 2 and 11.\"" .

