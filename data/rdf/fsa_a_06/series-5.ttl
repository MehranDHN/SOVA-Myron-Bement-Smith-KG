kg:note_ref24878_odd_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Local Numbers" ;
    crm:P148_has_component kg:note_ref24878_odd_0_p_0,
        kg:note_ref24878_odd_0_p_1 ;
    crm:P2_has_type mbs:OddNote ;
