    rdfs:label "D-693: Excavation of Kuh-e Khwaja (Iran): Ruins of Ghaga-Shahr: General Plan of \"Palace-Temple\" Complex, Annotated by Herzfeld" ;
    dct:identifier "FSA A.6 05.0693" ;
    crm:P102_has_title kg:title_ref24372 ;
    crm:P129_is_about kg:concept_aat_300263552,
