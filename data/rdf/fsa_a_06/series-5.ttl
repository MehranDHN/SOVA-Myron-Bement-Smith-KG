kg:note_ref9693_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9693_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Original caption on verso reads, \"Samarra. Dj. Mutawakkiliyye.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref9693_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9693_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Additional information reads, \"Herzfeld spent not more than two days during the second campaign in the mosque of al-Mutawakkiliyya (June 19-20, 1913), partially excavating the miḥrāb, and 'scraping' - as he admits himself - at the court facade of the transept and in the qibla aisle of the ḥaram, and finally at the plinth of the minaret. While Herzfeld sketched the overall plan of the Great Mosque complex at Mutawakkiliyya in 1913, the final product is based partially on measurements taken by his surveyor, Commander von Ludloff.\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.58.\"]" ;
    mbs:noteType mbs:ScopeContent .

