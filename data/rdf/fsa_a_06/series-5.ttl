    crm:P72_has_language lang:ger ;
    rdf:value "Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.115-144.\"" .

