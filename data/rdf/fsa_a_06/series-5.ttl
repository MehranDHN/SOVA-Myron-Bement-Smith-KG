    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Excavation of Samarra (Iraq): Qasr al-Ashiq, Three Blind Niches of the Northwestern Fac̦ade: Ground Plan and Elevation [drawing]" ;
    mbs:noteType mbs:ScopeContent .

