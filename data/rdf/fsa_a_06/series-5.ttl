kg:note_ref24938_odd_2_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "The monuments and inscriptions of Northern Syria were surveyed and collected between 1908 and 1914 by Moritz Sobernheim and Ernst Herzfeld as part of a broader project, sponsored by the Institut de France, that of Max van Berchem's \"Matériaux pour un Corpus Inscriptionum Arabicarum.\" The drawings are related to this survey as well as additional expeditions to Aleppo (Syria) carried out by Ernst Herzfeld in 1907, 1908, 1910, 1914, 1916, 1917, 1918, and 1930." .

kg:note_ref24939_arrangement_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers." .

kg:note_ref24939_bibliography_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "Herzfeld, Ernst. \"Matériaux pour un Corpus Inscriptionum Arabicarum, Part II, Tome II, vol.3, Plate XXXII.\"" .

kg:note_ref24939_odd_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "D-1341" .

kg:note_ref24939_odd_0_p_1 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "FSA A.06 05.1341" .

kg:note_ref24939_odd_1_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- Title is provided by Xavier Courouble, FSg Archives cataloger." .

kg:note_ref24939_odd_2_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "The monuments and inscriptions of Northern Syria were surveyed and collected between 1908 and 1914 by Moritz Sobernheim and Ernst Herzfeld as part of a broader project, sponsored by the Institut de France, that of Max van Berchem's \"Matériaux pour un Corpus Inscriptionum Arabicarum.\" The drawings are related to this survey as well as additional expeditions to Aleppo (Syria) carried out by Ernst Herzfeld in 1907, 1908, 1910, 1914, 1916, 1917, 1918, and 1930." .

kg:note_ref24940_arrangement_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
