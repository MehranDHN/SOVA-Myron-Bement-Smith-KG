    crm:P148_has_component kg:note_ref9653_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Paikuli (Iran), Ruins of the Sasanian Monument: Four Stone Busts Depicting King Narseh [drawing]" ;
    mbs:noteType mbs:ScopeContent .

