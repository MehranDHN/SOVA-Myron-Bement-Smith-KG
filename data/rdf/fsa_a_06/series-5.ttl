kg:component_ref8845 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-156: Baalbek. Inscription of Nur al-din. Kufic. Corpus, pl.LXXVIId" ;
    dct:identifier "FSA A.6 05.0156" ;
    crm:P102_has_title kg:title_ref8845 ;
    crm:P129_is_about kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_inscriptions_arabic,
        kg:concept_lcsh_sh85006507,
        kg:concept_lcsh_sh85066566 ;
    crm:P1_is_identified_by kg:title_ref8845 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Bibliography Herzfeld, Ernst. \"Matériaux pour un Corpus Inscriptionum Arabicarum, Vol. II, Tome II (Aleppo), pl.LXXVIId.\"",
        "Date/Time and Place of an Event Note As early as 1893, Ernst Herzfeld, Moritz Sobernheim, and Max Freiherr von Oppenheim participated in Max Van Berchem's project to create a Corpus Inscriptionum Arabicarum. During the following 25 years, research materials such as glass negatives, photographic prints, drawings, maps, and notebooks were circulating among the four archaeologists. In the case of this glass negative, it may have been taken by Moritz Sobernheim on a visit to Baalbeck between 1899 and 1905, as mentioned in his 1922 publication, \"Baalbek in Islamischer Zeit, in Voradruck aus dem Werke: Baalbek, Ergebnisse der Aus rabungen und Unterschungen in den Jahren 1898 bis 1905, Vol. 3.\"",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Ernst Herzfeld original drawings'caption and Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers D-156 D-156a FSA A.6 05.0156",
        "Scope and Contents Baalbek (Lebanon): Fortified Walls of the Citadel: Transcription of Arabic Inscription No. I, in Kufic Script [drawing]" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref8845 ;
    crm:P67_refers_to kg:agent_Q62933,
