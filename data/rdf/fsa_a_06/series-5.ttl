kg:component_ref24601 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1111f: Excavation of Samarra (Iraq): Fragments of Prehistoric Vessels and Artifacts, Found in the Qasr al-Ashiq" ;
    dct:identifier "FSA A.06 05.1111f" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref24601 ;
    crm:P129_is_about kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_decoration_and_ornament,
        kg:concept_excavations_archaeology,
        kg:concept_lcsh_sh85000061,
        kg:concept_lcsh_sh85005757,
        kg:concept_lcsh_sh85105729 ;
    crm:P1_is_identified_by kg:title_ref24601 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Date/Time and Place of an Event Note Drawings related primarly to the first campaign of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin in 1911.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Thomas Leisten's publication, Excavation of Samarra, vol 1.",
        "Local Numbers D-1111f FSA A.06 05.1111f",
        "Scope and Contents - \"The five barrel-vaulted sardābs of the ground level of the gateway abutting the palace were the focus of Herzfeld's excavation activities. Of the five sardābs forming the substructure for the rooms on the second-storey platform, the central one was partially excavated in 1911. The rooms had been filled with debris in the late madieval period when the second storey was remodeled. Finds included not only carved stucco fragments but also lustre and molded wares and a large percentage of Raqqa-wares.\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003; p.108.\"]",
        "Scope and Contents - Additional information reads, \"IN-393; IN-443; IN-440.\"",
        "Scope and Contents - Original caption reads, \"Samarra - Book 3.\"" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref24601 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref24601_arrangement_0,
        kg:note_ref24601_odd_0,
