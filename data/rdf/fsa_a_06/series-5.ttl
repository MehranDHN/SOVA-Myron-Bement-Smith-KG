kg:component_ref9745 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1082: Samarra, Great Mosque, marked \"unpublished\". Plan with Malwiyya, numbered 16" ;
    dct:identifier "FSA A.06 05.1082" ;
    crm:P102_has_title kg:title_ref9745 ;
    crm:P129_is_about kg:concept_aat_300007391,
        kg:concept_aat_300263552,
        kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_excavations_archaeology,
        kg:concept_lcsh_sh85000061 ;
    crm:P1_is_identified_by kg:title_ref9745 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Bibliography Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.38, fig.14.\"",
        "Date/Time and Place of an Event Note Drawings related primarly to the first campaign of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin in 1911.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Thomas Leisten's publication, Excavation of Samarra, vol 1.",
        "Local Numbers D-1082 FSA A.06 05.1082",
        "Scope and Contents Additional information reads, \"The quest for exceptional artifacts from the mosque was not very rewarding: with the exception of the minaret, the outer walls were the only remnant of the mosque left standing. All of the interior, as well as the halls of the ziyāda outsie had been destroyed and stripped for building materials, especially wood, brick, and marble. Work began on January 9, 1911 with 150 workers outside the mosque right behind the three openings in the center of the qibla aisle, which Herzfeld mistook in the beginning for a triple entrance despite the fact that it was directed towards the qibla and there were no other signs of a miḥrāb. The struggle to uncover the 'triple gate' continued through January 25. Only on February 2 was the recessed profile of the miḥrāb set in rectangular frame excavated and recognized as part of the prayer niche. Almost simultaneously with the areas in front of the miḥrāb and outside the qibla wall, more trenches inside and outside the mosque were opened (January 29). On January 30 the southeastern entrance of the mosque was uncovered, and a day later the southern end of the eastern riwāq investigated. More time was spent examining the fountain in the center of the courtyard, because stucco and mosaic framents were found there (January 30-February 2). Finally, two more days were invested in making two soundings at the base of the Malwiyya minaret and the northern wall of the mosque at the end of February (25 and 26). The excavation of the congregational mosque at Samarra was closed on February 26, 1911.\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.36.\"]",
        "Scope and Contents Excavation of Samarra (Iraq): Great Mosque of al-Mutawakkil and its Spiraling Minaret (Malwiyya) [drawing]",
        "Scope and Contents Original caption on verso reads, \"Samarra. Gr. Mosque, unpublished.\"" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref9745 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref9745_arrangement_0,
        kg:note_ref9745_bibliography_0,
        kg:note_ref9745_odd_0,
        kg:note_ref9745_odd_1,
        kg:note_ref9745_odd_2,
        kg:note_ref9745_scopecontent_0,
        kg:note_ref9745_scopecontent_1,
        kg:note_ref9745_scopecontent_2,
        kg:place_iraq_salah_ad_din_samarra_great_mosque_of_al_mutawakkil,
        kg:place_mesopotamia,
        kg:place_samarra_iraq,
        kg:place_tgn_1000004,
        kg:place_tgn_1000118 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref9745> ;
