kg:note_ref24837_odd_2_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:fre ;
    rdf:value "The monuments and inscriptions of Northern Syria were surveyed and collected between 1908 and 1914 by Moritz Sobernheim and Ernst Herzfeld as part of a broader project, sponsored by the Institut de France, that of Max van Berchem's \"Matériaux pour un Corpus Inscriptionum Arabicarum.\" The drawings are related to this survey as well as additional expeditions to Aleppo (Syria) carried out by Ernst Herzfeld in 1907, 1908, 1910, 1914, 1916, 1917, 1918, and 1930." .

kg:note_ref24837_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:fre ;
    rdf:value "Original caption in French reads, \"Plan Général de la ville de Halep.\"" .

