    crm:P148_has_component kg:note_ref9799_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Kings Enthroned, from Coin Devices [drawing]" ;
    mbs:noteType mbs:ScopeContent .

