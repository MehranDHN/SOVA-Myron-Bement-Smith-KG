        kg:place_tgn_7000231,
        kg:place_tgn_7001657 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref24725> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3f94747b3-6844-48ff-842a-a4b6372e90ce> ;
    mbs:archivalLevel "item" ;
