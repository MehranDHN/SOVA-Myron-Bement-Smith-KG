kg:component_ref9793 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1134: Samarra, Great mosque. Portal (?). Unpublished" ;
    dct:identifier "FSA A.06 05.1134" ;
    crm:P102_has_title kg:title_ref9793 ;
    crm:P129_is_about kg:concept_aat_300007391,
        kg:concept_aat_300263552,
        kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_excavations_archaeology,
        kg:concept_lcsh_sh85000061 ;
    crm:P1_is_identified_by kg:title_ref9793 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Bibliography Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.35-57.\"",
        "Date/Time and Place of an Event Note Drawings related primarly to the first campaign of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin in 1911.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Thomas Leisten's publication, Excavation of Samarra, vol 1.",
        "Local Numbers D-1134 FSA A.06 05.1134",
        "Scope and Contents Additional information reads, \"Clearing the debris along the inner qibla wall provided evidence that its center had not been occupied bu a large triple gate but by a miḥrāb of enormous, yet harmonious dimensions flanked by a gate on each side. The actual prayer-niche turned out to be a fairly deep, rectangular recess. Standing in rectangular staggered recesses, a double set of columns flanked the niche. From the fragments found in this spot, Herzfeld concluded that each set of columns had been composed of a pair made of different color marbles. No parts of any of the column's bases were found in the mosque proper. In spite of the miḥrāb's complete destruction, a horizontal line visible at the outside of the qibla wall testiffies that the projecting miḥrāb box originally had a flat roof.\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.46.\"]",
        "Scope and Contents Excavation of Samarra (Iraq): Great Mosque of al-Mutawakkil, Reconstruction of the Mihrab: Ground Plan and Section [drawing]",
        "Scope and Contents Original caption on verso reads, \"Samarra. Gr. M., unpublished.\"" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref9793 ;
    crm:P67_refers_to kg:agent_Q62933,
