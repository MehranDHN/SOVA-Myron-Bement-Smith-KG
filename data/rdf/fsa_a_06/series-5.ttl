kg:component_ref9775 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1113: Samarra. Haus IV. Marked \"from Sketchbook\". Unpublished" ;
    dct:identifier "FSA A.06 05.1113" ;
    crm:P102_has_title kg:title_ref9775 ;
    crm:P129_is_about kg:concept_aat_300263552,
        kg:concept_architectural_drawing,
        kg:concept_art_of_the_islamic_world,
        kg:concept_excavations_archaeology,
        kg:concept_lcsh_sh85000061 ;
    crm:P1_is_identified_by kg:title_ref9775 ;
    crm:P2_has_type aat:300033973,
        kg:concept_drawings ;
    crm:P3_has_note "Arrangement Drawings are arranged roughly in sequential number sequences, housed in document boxes or in flat file folders by size, and stored in the map case drawers.",
        "Bibliography Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003; p.115-144.\"",
        "Date/Time and Place of an Event Note Drawings related primarly to the first campaign of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin in 1911.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Thomas Leisten's publication, Excavation of Samarra, vol 1.",
        "Local Numbers D-1113 FSA A.06 05.1113",
        "Scope and Contents Excavation of Samarra (Iraq): al-Quraina, House IV: Ground Plan [drawing]",
        "Scope and Contents Original handwritten notes reads, \"Haus IV; from sketch book. Samarra. unpublished.\"",
        "Scope and Contents The identification of the residential sites: \"Herzfeld numbered all sites while the excavation was still in progress. When it became obvious that two courtyards with adjacent rooms turned out to belong to the same complex, however, he assigned new numbers. Herzfeld gave numbers to 16 houses in various locations, splitting certain buildings, [...] naming in all 24 different sites. [...]. Unfortunately, Herzfeld changed the numbering of the houses a third time when he finished the final drawings for the publication, including only 14 houses. [...]. In those cases in which Herzfeld noted on his field sketch either the name of the area or the new numbering of the house we can at least identify the site. [...].\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003; p.121.\"]" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref9775 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref9775_arrangement_0,
        kg:note_ref9775_bibliography_0,
        kg:note_ref9775_odd_0,
        kg:note_ref9775_odd_1,
        kg:note_ref9775_odd_2,
        kg:note_ref9775_scopecontent_0,
        kg:note_ref9775_scopecontent_1,
        kg:note_ref9775_scopecontent_2,
        kg:place_iraq_salah_ad_din_samarra_al_quraina,
        kg:place_mesopotamia,
        kg:place_samarra_iraq,
        kg:place_tgn_1000004,
        kg:place_tgn_1000118 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref9775> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3082d2e0f-bae8-473a-9381-61348cd13005> ;
    mbs:archivalLevel "item" ;
