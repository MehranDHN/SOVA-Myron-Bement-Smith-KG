        mbs:ItemUnit ;
    rdfs:label "D-1479: Excavation of Pasargadae and Persepolis (Iran): Palace P, Old Persian Inscription, CMc, and Harem, Door-knob, Old Persian Inscription, DPi" ;
    dct:identifier "FSA A.06 05.1479" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref24835 ;
