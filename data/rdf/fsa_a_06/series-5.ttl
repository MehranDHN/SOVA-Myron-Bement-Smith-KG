    crm:P72_has_language lang:eng ;
    rdf:value "Scope and Contents - Additional information reads, \"One duplicate copy, local number: FSA A.6 05.1009duplicates, not available online, stored in map case drawer 32.\"" ;
    mbs:noteType mbs:ScopeContent .

