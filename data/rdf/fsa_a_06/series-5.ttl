kg:component_ref24505 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-800: Excavation of Pasargadae (Iran): Measured Plan of Area with Altars and Temple, probably drawn by Friedrich Krefter" ;
    dct:identifier "FSA A.06 05.0800" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref24505 ;
    crm:P129_is_about kg:concept_aat_300263552,
