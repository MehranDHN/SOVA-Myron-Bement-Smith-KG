    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Paikuli (Iraq), Ruins of the Sasanian Monument: Reconstruction of the Commemorative Tower, [drawing]" ;
    mbs:noteType mbs:ScopeContent .

