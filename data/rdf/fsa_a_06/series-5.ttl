kg:note_ref24718_odd_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Date/Time and Place of an Event Note" ;
    crm:P148_has_component kg:note_ref24718_odd_2_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    crm:P72_has_language lang:ger ;
    rdf:value "Date/Time and Place of an Event Note Drawing paper related primarly to the excavation of Persepolis, initiated by Ernst Herzfeld in early March 1931, under the auspices of the Oriental Institute of the University of Chicago. Herzfeld left Persepolis permanently in Spring 1934." ;
    mbs:noteType mbs:OddNote .

