        mbs:ItemUnit ;
    rdfs:label "D-99, D-100: Aleppo (Syria): Hammam al-Qadi and Mosque of al-Hajj al-Haramain: Arabic Inscriptions, in Naskhi Mameluke Script" ;
    dct:identifier "FSA A.06 05.0099" ;
    crm:P102_has_title kg:title_ref24329 ;
    crm:P106_is_composed_of kg:component_ref8781,
        kg:component_ref8782 ;
