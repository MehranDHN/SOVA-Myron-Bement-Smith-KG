kg:note_ref9735_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9735_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Original handwritten notes reads, \"House VI and VII (in red pencil). Samarra, unpublished. 23 (in red pencil).\"" ;
