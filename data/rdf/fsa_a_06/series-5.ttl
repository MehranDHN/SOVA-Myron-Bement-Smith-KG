kg:component_ref24755 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1304: Excavation of Pasargadae and Persepolis (Iran): Palace P, Old Persian Inscription, CMc, and Tachara Palace (Palace of Darius), Inscription of Xerxes" ;
    dct:identifier "FSA A.06 05.1304" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref24755 ;
    crm:P129_is_about kg:concept_ancient_near_eastern_art,
