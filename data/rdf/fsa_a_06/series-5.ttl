kg:note_ref9753_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9753_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Additional information reads, \"It should be noted that other small pavilions at a site that suggests a look-out point are known in Samarra but have not been preserved. A prominent example was located on the Tall al-ʿAlīq east of the Dār al-Khilāfa and served as a spectator's lodge for one of the race-tracks.\" [Leisten, Thomas, 2003: \"Excavation of Samarra, v. I. Architecture : Final report of the first campaign 1910-1912. Verlag Philipp von Zabern, Mainz am Rhein, 2003. p.77n.\"]" ;
    mbs:noteType mbs:ScopeContent .

