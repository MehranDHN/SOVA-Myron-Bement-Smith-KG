kg:note_ref24349_odd_2_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "Ernst Herzfeld first visited the site of Taq-i Bustan (Iran) in early August 1913 while on an expedition from Samarra (Iraq) to Asadabad (Hamadan, Iran). The drawing may be related primarly to this expedition as well as to additional visits to Taq-i Bustan (Iran) carried out by Ernst Herzfeld in 1917 and 1923 (end of June)." .

