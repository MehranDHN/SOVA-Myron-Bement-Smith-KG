kg:component_ref9741 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "D-1078: Samarra, Great Mosque, marked \"unpublished\". Plan, numbered 13" ;
    dct:identifier "FSA A.06 05.1078" ;
    crm:P102_has_title kg:title_ref9741 ;
    crm:P129_is_about kg:concept_aat_300007391,
