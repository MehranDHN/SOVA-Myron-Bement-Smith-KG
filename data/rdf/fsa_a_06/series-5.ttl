    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Excavation of Samarra (Iraq): West of Sur Isa, House XIII: Ground Plan [drawing]" ;
    mbs:noteType mbs:ScopeContent .

