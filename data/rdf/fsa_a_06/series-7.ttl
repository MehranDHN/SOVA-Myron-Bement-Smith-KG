kg:note_ref10460_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10460_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents The inventory numbers noted in the sketchbooks refer to entries in the Samarra Fundjournal (No.S-1) where rough sketches accompany detailed descriptions, location of finds, etc., cross-referenced to the sketchbooks of measured drawings. In the Fundjournal, the unpublished Houses have been re-numbered. Herzfeld used \"In.\" as the abbreviation of Inventory in all his references, so that is used here." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10460_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10460_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - The first of a series of eighteen sketchbooks (Skizzenbücher), in which Ernst Herzfeld recorded his observations on archaeological remains, artifacts and decorative motifs, related to the congregational mosque; the palace of the Caliph (Dār al-Khilāfa, Bayt al-Khalīfah, Jawsaq al-Khaqani); the palace of Balkuwārā; the Qaṣr al-ʿĀshiq; and finally the residential architecture." ;
    mbs:noteType mbs:ScopeContent .

