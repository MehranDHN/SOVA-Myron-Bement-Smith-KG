kg:note_ref10614_odd_1 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref10614_odd_1_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Joseph Upton's Catalogue of the Herzfeld Archive." ;
    mbs:noteType mbs:OddNote .

kg:note_ref10614_odd_2 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref10614_odd_2_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Series title in Joseph Upton's Catalogue of the Herzfeld Archive reads, \"Records of Samarra Expeditions.\"" ;
    mbs:noteType mbs:OddNote .

kg:note_ref10614_odd_3 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref10614_odd_3_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Since these are primary sources, handwritten captions in the sketchbook are specified in three stages: (1) an English designation following Thomas Leisten and Alastair Northedge's terminology; (2) the transcribed original caption in German which is provided under parenthesis; and (3) additonal information from Herzfeld's publication, \"Der Wandschmuck der Bauten von Samarra und Seine Ornamentik. Verlag Dietrich Reimer, Ernst Vohsen, Berlin, 1923.\" and Alastair Northedge's publication, \"An Interpretation of the Palace of the Caliph at Samarra (Dar Al-Khilafa or Jawsaq Al-Khaqani). In Ars Orientalis, Vol. 23. Gülru Necipoglu, ed. Ann Arbour: Department of History, University of Michigan, 1993.\" which is provided under bracket." ;
    mbs:noteType mbs:OddNote .

kg:note_ref10614_odd_4 a crm:E33_Linguistic_Object ;
    rdfs:label "Date/Time and Place of an Event Note" ;
    crm:P148_has_component kg:note_ref10614_odd_4_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "Date/Time and Place of an Event Note Notes related primarly to the two campaigns of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin between the years 1911 and 1913." ;
    mbs:noteType mbs:OddNote .

