kg:note_ref24662_odd_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Date/Time and Place of an Event Note" ;
    crm:P148_has_component kg:note_ref24662_odd_2_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    crm:P72_has_language lang:und ;
    rdf:value "Date/Time and Place of an Event Note Drawing related to a trial excavation undertook by Ernst Herzfeld in the Summer 1928 as well as a campaign of excavation at the western mound, Tall-i-Bakun A under the auspice of the Oriental Institute of the University of Chicago, carried out by Alexander Langsdorff under Ernst Herzfeld's direction between March 25, 1932 and July 21, 1932." ;
    mbs:noteType mbs:OddNote .

