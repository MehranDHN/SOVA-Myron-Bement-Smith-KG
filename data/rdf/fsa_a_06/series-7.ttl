kg:note_ref10759_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10759_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - The eighteenth of a series of eighteen sketchbooks (Skizzenbücher), in which Ernst Herzfeld recorded his observations on topography, landscape, archaeological remains, architecture, artifacts and decorative motifs, related to the congregational mosques in Samarra, Mutawakkiliyya, and Balkuwārā; the Qubbat al-Ṣulaibiyya; the palaces of Balkuwārā, Ṣūr ʿĪṣā, and the Qaṣr al-ʿĀshiq; and finally the residential architecture and the baths at Quraina, Wadī al-Muḥḥ, Qāṭūn, Jubairiyya, and west of Ṣūr ʿĪṣā." ;
    mbs:noteType mbs:ScopeContent .

