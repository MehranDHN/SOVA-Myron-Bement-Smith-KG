    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - The account of the trip to Ctesiphon reads, \"Balad, September 12, 1911 (pp. 63-67); Sumaikah, September 13, 1911 (pp. 68-73); Shari'ah al-Azam, September 14, 1911 (pp. 73-79); Ktesiphon, September 17, 1911 (pp. 79-82); Ktesiphon, September 18, 1911 (pp. 82-89); Seleukia, September 19, 1911 (pp. 89-94); Samarra, October 8, 1911 (p. 95).\"" ;
    mbs:noteType mbs:ScopeContent .

