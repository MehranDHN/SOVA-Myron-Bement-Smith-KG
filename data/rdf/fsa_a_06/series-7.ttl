kg:note_ref10693_odd_3 a crm:E33_Linguistic_Object ;
    rdfs:label "Date/Time and Place of an Event Note" ;
    crm:P148_has_component kg:note_ref10693_odd_3_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "Date/Time and Place of an Event Note Notes related primarly to the two campaigns of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin between the years 1911 and 1913." ;
    mbs:noteType mbs:OddNote .

