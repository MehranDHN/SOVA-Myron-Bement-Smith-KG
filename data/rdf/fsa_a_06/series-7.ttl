kg:component_ref24648 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Excavation of Samarra (Iraq): Seven Ground Plans of Private Houses Containing the Locations of Wall Ornamentation" ;
    dct:identifier "FSA A.06 07.30.01" ;
    crm:P102_has_title kg:title_ref24648 ;
    crm:P129_is_about kg:concept_aat_300263552,
        kg:concept_architectural_drawing,
