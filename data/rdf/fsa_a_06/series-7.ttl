        kg:place_tgn_1000118,
        kg:place_tgn_7011132 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref24961> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3be84d9ca-a7d8-4ae2-bcd5-60f92f7e210e> ;
    mbs:archivalLevel "item" ;
