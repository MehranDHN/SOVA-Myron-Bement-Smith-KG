kg:note_ref24610_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref24610_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 01.03, on which Joseph Upton's classification mentions \"S-10\", provides an account of an expedition (November 20, 1905 to January 5, 1906) from Samarra (Iraq) to Asadabad (Iran). It Includes extensive notes on monuments along the ancient road from Ctesiphon to Azerbaijan." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref24610_scopecontent_1 a crm:E33_Linguistic_Object ;
