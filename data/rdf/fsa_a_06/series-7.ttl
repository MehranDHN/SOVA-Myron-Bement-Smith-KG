    crm:P148_has_component kg:note_ref24648_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Original caption for item 'a' reads, \"Qurainah, Haus I.\" Additional information for item 'a' reads, \"Quraina. House I and II. Decorative motifs are specified in room 1, room 38, room 41, and in the great courtyard.\"" ;
    mbs:noteType mbs:ScopeContent .

