    crm:P102_has_title kg:title_FSA_A_06 ;
    crm:P106i_forms_part_of kg:collection_islamic_archives ;
    crm:P129_is_about kg:concept_aat_300007391,
        kg:concept_aerial_photography,
        kg:concept_ancient_near_eastern_art,
        kg:concept_architectural_drawing,
