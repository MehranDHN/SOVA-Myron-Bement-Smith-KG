    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from Joseph Upton's Finding Aid reads, \"Squeeze No. 114. [no neg. but existing photographic print in file 33-16, p.30, left] Naqsh-i Rustam, Great Lower Inscription. 77-6. File 33-30, left.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10414_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
