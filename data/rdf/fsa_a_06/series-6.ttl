        kg:note_ref10360_scopecontent_2,
        kg:note_ref10360_scopecontent_3,
        kg:note_ref10360_scopecontent_4,
        kg:note_ref10360_scopecontent_5,
        kg:place_iran_fars_takht_e_jamshid_southern_terrace_wall,
