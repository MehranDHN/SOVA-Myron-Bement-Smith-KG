kg:note_ref10299_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10299_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from Joseph Upton's Finding Aid reads, \"Squeeze No. 23. ([neg.] 5037, bottom) Naqsh-i Rustam. \"Akkad. M\" IIb. [Lines] 5-11.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10299_scopecontent_3 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10299_scopecontent_3_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Information from Roland G. Kent's 1953 publication reads, \"DNb = Darius, Naqsh-i Rustam. The inscription Naqsh-i Rustam B stands on the two sides of the door in the center of the crossbeam: Old Persian in the panel to its left, in 60 lines; Elamite, 43 lines, in the panel to the right, with an Aramaic version in 25 lines at the bottom; in the last panel to the right, the Akkadian version in 39 lines with the space of one line vacant between lines 31 and 32.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10299_scopecontent_4 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10299_scopecontent_4_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from Roland G. Kent's publication reads, \"Some miles north of Persepolis, on the south face of a steep ridge known as Ḥusain Kūh or 'Mountain of Husain', there are four gigantic niches, cut in the shape of Greek crosses, and serving as entrances to the tombs lying in the rock behind them. The second from the east is the tomb of Darius I, and bears inscriptions.\" [Roland Kent: Old Persian. Grammar, Texts, Lexicon. 2nd Revised Edition. American Oriental Society, Vol. 33. American Oriental Society, New Haven, Connecticut, 1953, p.109.\"]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10299_scopecontent_5 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10299_scopecontent_5_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from staff reads, \"Herzfeld has divided the Akkadian version of inscription DNb into six row of squeezes, numbered I to VI, with a total of 39 lines. A letter, numbered a to e, then was added to the Roman numeral for the position of the squeeze starting from left. This squeeze has been numbered by Herzfeld: IIb.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10299_scopecontent_6 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10299_scopecontent_6_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Naqsh-i Rustam (Iran): Squeeze of Inscription, DNb, Akkadian Version, on the Tomb of Darius I" ;
    mbs:noteType mbs:ScopeContent .

