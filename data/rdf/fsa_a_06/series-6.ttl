    rdf:value "Scope and Contents - Additional information from Joseph Upton's Finding Aid reads, \"Squeeze No. 1. ([neg.] 5053, bottom, and [neg.] 5038) Naqsh-i Rustam. Lines 1-6, left.\"" ;
    mbs:noteType mbs:ScopeContent .

