    crm:P2_has_type mbs:Arrangement ;
    rdf:value "Arrangement Papers squeezes are organized in sequential number following language scripts, which are housed in folders, and stored in metal flat files." ;
    mbs:noteType mbs:Arrangement .

kg:note_ref9998_bibliography_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Bibliography" ;
    crm:P148_has_component kg:note_ref9998_bibliography_0_p_0 ;
    crm:P2_has_type mbs:Bibliography ;
    rdf:value "Bibliography Herzfeld, Ernst, 1924: \"Paikuli: Monument and Inscription of the Early History of the Sasanian Empire; Volume II, containing 228 plates. Berlin: D. Reimer, Ernst Vohsen. Plate 127.\"" ;
    mbs:noteType mbs:Bibliography .

