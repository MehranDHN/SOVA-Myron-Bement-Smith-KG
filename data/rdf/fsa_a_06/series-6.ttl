    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from staff reads, \"Squeeze No. 88: 72, lines 1-20.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10388_scopecontent_5 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
