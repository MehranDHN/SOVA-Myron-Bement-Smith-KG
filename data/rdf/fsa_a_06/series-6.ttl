    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from staff reads, \"Squeeze No. 80: 67f, lines 7-12, center top right edge.\"" ;
    mbs:noteType mbs:ScopeContent .

