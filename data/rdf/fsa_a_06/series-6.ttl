    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from staff reads, \"Squeeze No. 70: 70b, lines 16-24, top center.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10370_scopecontent_5 a crm:E33_Linguistic_Object ;
