kg:component_ref9959 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "A-34: Pasargadae. Palace R. Detail of colossal door figure. See SK-IX, p.28" ;
    dct:identifier "FSA A.6 06.A034" ;
    crm:P102_has_title kg:title_ref9959 ;
