kg:note_ref25746_odd_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Date/Time and Place of an Event Note" ;
    crm:P148_has_component kg:note_ref25746_odd_2_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    crm:P72_has_language lang:und ;
    rdf:value "Date/Time and Place of an Event Note Ernst Herzfeld first visited the site of Taq-i Bustan (Iran) in early August 1913 while on an expedition from Samarra (Iraq) to Asadabad (Hamadan, Iran). The paper squeeze may be related primarly to this expedition as well as to additional visits to Taq-i Bustan (Iran) carried out by Ernst Herzfeld in 1917 and 1923 (end of June)." ;
    mbs:noteType mbs:OddNote .

