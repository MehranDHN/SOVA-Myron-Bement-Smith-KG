kg:component_ref10162 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "M-88: Parsik, publ. Paikuli. p.99" ;
    dct:identifier "FSA A.6 06.M088" ;
    crm:P102_has_title kg:title_ref10162 ;
