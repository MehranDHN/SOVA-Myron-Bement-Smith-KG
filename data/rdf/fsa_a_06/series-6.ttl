    rdfs:label "Local Numbers" ;
    crm:P148_has_component kg:note_ref9998_odd_0_p_0,
        kg:note_ref9998_odd_0_p_1 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "Local Numbers M-006 FSA A.6 06.M006" ;
