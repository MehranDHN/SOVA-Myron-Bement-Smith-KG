kg:note_ref10414_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10414_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Information from Roland G. Kent's 1953 publication reads, \"DNb = Darius, Naqsh-i Rustam. The inscrition Naqsh-i Rustam B stands on the two sides of the door in the center of the crossbeam: Old Persian in the panel to its left, in 60 lines; Elamite, 43 lines, in the panel to the right, with an Aramaic version in 25 lines at the bottom; in the last panel to the right, the Akkadian version in 39 lines with the space of one line vacant between lines 31 and 32.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10414_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
