        kg:place_tgn_1000118 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref9988> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc32aa1c202-17f9-4ee4-8e5f-3ed37210985f> ;
    mbs:archivalLevel "item" ;
