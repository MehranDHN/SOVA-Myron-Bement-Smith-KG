    rdf:value "Scope and Contents Excavation of Persepolis (Iran): Squeeze of \"Foundation Inscriptions\", DPe, Old Persian Version, Inscribed on Southern Terrace Wall" ;
    mbs:noteType mbs:ScopeContent .

