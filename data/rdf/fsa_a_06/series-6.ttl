kg:note_ref10360_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10360_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from Joseph Upton's Finding Aid reads, \"Squeeze No. 60. Persepolis, Great Terrace inscription. Elamite text, 68a.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10360_scopecontent_3 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10360_scopecontent_3_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from Corpus Inscriptionum Iranicarum; Part I, Inscriptions of Ancient Iran; Vol. I, The Old Persian Inscriptions reads, \"The architectural activities in Persepolis started soon after 519 B.C. ...and continued until Alexander's arrival in 330 B.C.. The structures -and hence the cuneiform inscriptions- of Persepolis were thus created in the space of nearly two hundred years. The original approach to the Persepolis platform was from the south, but Xerxes blocked that entry when he finished the north-western stairway. Not far from the original southern stairway, Darius the Great had carved, on a single block, four cuneiform texts (DPd and DPe in Old Persian, DPf in Elamite, and DPg in Babylonian). These serve as the 'foundation inscriptions' of Persepolis.\" [Corpus Inscriptionum Iranicarum; Part I, Inscriptions of Ancient Iran; Vol. I, The Old Persian Inscriptions; Portfolio I: Plates i-xlviii. Old Persian Inscriptions of the Persepolis platform. Edited by A. Shapur Shahbazi. Published by Lund Humphries, London, 1985. Pp.15-16.\"]" ;
    mbs:noteType mbs:ScopeContent .

