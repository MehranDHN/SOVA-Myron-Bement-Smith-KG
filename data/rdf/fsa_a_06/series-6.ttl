kg:note_ref25748_odd_2_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "Paper squeezes related primarly to the two campaigns of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin between the years 1911 and 1913." .

kg:note_ref25748_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- Additional information from staff reads, \"It was in the Eastern Īwān of the Balkuwārā Palace that the well-known beam with the inscription \"al-amīr al-Muʿtazz bi-llāh b. amīr al-Muʿminīn,\" carved into one of the sides, was recovered. Three paper squeezes, FSA A.6 06.A003 (left), FSA A.6 06.A003a (center), and FSA A.6 06.A003b (right), were applied on the single inscription.\"" .

kg:note_ref25748_scopecontent_1_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- Additional information from Joseph Upton's Finding Aid reads, \"Arabic No. 3: [no neg]. Four duplicate squeezes, single line, numbered 3/3c. Marked in red \"SAM\"; in blue 499.\"" .

kg:note_ref25749_arrangement_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
