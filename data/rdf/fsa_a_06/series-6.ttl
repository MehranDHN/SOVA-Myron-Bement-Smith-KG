kg:component_ref25724 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "A-32: Excavation of Pasargadae (Iran): Squeeze of Arabic Inscriptions, from Mirhab of Mausoleum of Cyrus the Great" ;
    dct:identifier "FSA A.6 06.A032" ;
    crm:P102_has_title kg:title_ref25724 ;
    crm:P129_is_about kg:concept_art_of_the_islamic_world,
        kg:concept_excavations_archaeology,
        kg:concept_inscriptions_arabic,
        kg:concept_lcsh_sh85066566 ;
    crm:P1_is_identified_by kg:title_ref25724 ;
    crm:P2_has_type kg:concept_paper_squeezes ;
    crm:P3_has_note "Arrangement Papers squeezes are organized in sequential number following language scripts, which are housed in folders, and stored in metal flat files.",
        "Date/Time and Place of an Event Note Ernst Herzfeld first visited the site of Pasargadae in November 1905 while on an expedition from Assur (Kalat Schergat, Iraq) to Shiraz (Iran). In mid-November 1923, he conducted a preleminary campaign, completing various measured plans and drawings. Finally, a four-week session of excavations in April and May 1928, funded by the Notgemeinschaft der Deutschen Wissenschaft, was carried out by Ernst Herzfeld, assisted by the architect Friedrich Krefter.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers A-32 FSA A.6 06.A032",
        "Scope and Contents Additional information from Ernst Herzfeld's notebook, N-109 (Arabische Inschriften II), reads, \"[Page] 71. Pasargadae, Kyrosgrab.\"",
        "Scope and Contents Additional information from Joseph Upton's Finding Aid reads, \"Arabic No. 32: [no neg.] Pasargadae. Tomb of Cyrus, mihrāb. Four sections, numbered 32/32c. See N-109, p.71 and SK-IX, p.49.\"" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref25724 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref25724_arrangement_0,
        kg:note_ref25724_odd_0,
        kg:note_ref25724_odd_1,
        kg:note_ref25724_odd_2,
        kg:note_ref25724_scopecontent_0,
        kg:note_ref25724_scopecontent_1,
        kg:place_iran_fars_pasargadae_tomb_of_cyrus_the_great,
        kg:place_tgn_1000004,
        kg:place_tgn_7000231,
        kg:place_tgn_7001658 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref25724> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc35c99fd51-b33e-4789-bb14-eac9ed6c213f> ;
    mbs:archivalLevel "item" ;
    mbs:digitizationKind mbs:ids_image ;
    mbs:digitized true ;
    mbs:eadRef "ref25724" ;
    mbs:hasDigitalObject kg:digital_fs_fsa_a_06_06_a032 ;
    mbs:hasLinguisticObject kg:note_ref25724_arrangement_0,
        kg:note_ref25724_odd_0,
        kg:note_ref25724_odd_1,
        kg:note_ref25724_odd_2,
        kg:note_ref25724_scopecontent_0,
        kg:note_ref25724_scopecontent_1 ;
    mbs:hasParentComponent kg:component_ref9957 ;
    mbs:hasPhysicalUnit kg:physical_ref25724 ;
