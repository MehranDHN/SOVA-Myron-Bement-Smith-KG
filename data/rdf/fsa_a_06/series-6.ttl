    crm:P2_has_type mbs:OddNote ;
    crm:P72_has_language lang:und ;
    rdf:value "Date/Time and Place of an Event Note Paper squeezes related primarly to the two campaigns of excavation at Sāmarrāʼ (Iraq), carried out by Ernst Herzfeld on behalf of the Kaiser Friedrich Museum in Berlin between the years 1911 and 1913." ;
    mbs:noteType mbs:OddNote .

