        kg:place_tgn_1000004,
        kg:place_tgn_7000231,
        kg:place_tgn_7001657 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref25705> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc343acf3de-f1ff-4d7f-9f4c-be6ba7da5fb0> ;
