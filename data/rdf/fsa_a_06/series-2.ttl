kg:note_ref7658_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref7658_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - SK-25 is the twenty-fifth of a series of thirty-five sketchbooks (Skizzenbücher), in which Ernst Herzfeld recorded his observations on archaeological remains, prehistoric artifacts and decorative motifs related to Nineveh (Iraq), Ur (Iraq), Samarra (Iraq), Hamadan (Iran), Harsin (Iran), Kermanshah (Iran), and Shiraz (Iran). The observations on objects from Nineveh, Ur, and Hamadan were made from artifacts in the British Museum. The sketches related to Samarra were made at the time of Herzfeld last visit to the site." ;
    mbs:noteType mbs:ScopeContent .

