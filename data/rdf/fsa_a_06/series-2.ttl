    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - SK-26 is the twenty-sixth of a series of thirty-five sketchbooks (Skizzenbücher), in which Ernst Herzfeld recorded his observations on archaeological remains, prehistoric artifacts and decorative motifs." ;
