kg:note_ref7880_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref7880_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - SK-29 is the twenty-ninth of a series of thirty-five sketchbooks (Skizzenbücher), in which Ernst Herzfeld recorded his observations on archaeological remains, prehistoric artifacts and decorative motifs related to Harsin (Iran) and the prehistoric mound of Tepe Giyan (Iran)." ;
    mbs:noteType mbs:ScopeContent .

