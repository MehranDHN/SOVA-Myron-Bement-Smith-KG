        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "SK-XXI Persepolis" ;
    dct:identifier "FSA A.06 02.07.21" ;
    crm:P102_has_title kg:title_ref7599 ;
    crm:P106_is_composed_of kg:component_ref7600,
        kg:component_ref7601,
