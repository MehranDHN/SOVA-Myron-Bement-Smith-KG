    rdf:value "Former Title or Title Variations Ernst Herzeld; Skizzenbuch XXVIII: Antiken II" ;
    mbs:noteType mbs:OddNote .

kg:note_ref7836_odd_2 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref7836_odd_2_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Herzfeld's original sketchbook title and Joseph Upton's Catalogue of the Herzfeld Archive." ;
    mbs:noteType mbs:OddNote .

kg:note_ref7836_odd_3 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref7836_odd_3_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Additional information from staff reads, \"Ernst Herzfeld inadvertently duplicated the numbering of page 29 through page 35. He later corrected the duplicated set of numbers which now ranges from page 35 to page 47. Unfortunately, in his four inventories of objects, he did not apply these corrections when referring to sketchbook 28.\"" ;
    mbs:noteType mbs:OddNote .

kg:note_ref7836_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref7836_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents (The numbers in black are Herzfeld Inventory numbers; those preceeded by \"ph\" or \"Photo are negative numbers)" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref7836_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref7836_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - SK-28 is the twenty-eighth of a series of thirty-five sketchbooks (Skizzenbücher), in which Ernst Herzfeld recorded his observations on archaeological remains, reliefs and inscriptions, prehistoric artifacts and decorative motifs related to Babylon (Iraq), Baghdad (Iraq), Bujnurd (Iran), Constantinople (Turkey), Hamadan (Iran), Harsin (Iran), Isfahan (Iran), Masshad (Iran), Nihavand (Iran), Ray (Iran), Saveh (Iran) and the prehistoric mound of Tepe Giyan (Iran)." ;
    mbs:noteType mbs:ScopeContent .

