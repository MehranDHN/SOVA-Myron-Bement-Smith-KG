    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Series title in Joseph Upton's Catalogue of the Herzfeld Archive reads, \"Series 2: Sketchbooks, 1923-1931, n.d..\"" ;
    mbs:noteType mbs:OddNote .

kg:note_ref6806_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents All notes are in German." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - \"Ernst Herzfeld Papers, Series 2: Sketchbooks, 1923-1931,\" which is composed of 35 sketchbooks (Skizzenbücher), is organized into thirteen subseries and covers Herzfeld's travels and surveys of the most major archaeological sites in Persia, Mesopotamia and Northern Syria, from 1923 to 1931. It also covers the field activities at Pasargadae (Spring 1928) and of the Persepolis Expedition (1931)." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_10 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_10_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.09, which includes one sketchbook (Skizzenbüch XXIV), provides records of measurements for topographical maps with calculations related to Firuzabad (Iran), Khurha (Iran), Pasargadae (Iran), Naqsh-i Rustam (Iran), and Persepolis (Iran)." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_11 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_11_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.10, which includes one sketchbook (Skizzenbüch XXV), provides records of Herzfeld's observations on archaeological remains and prehistoric artifacts related to Nineveh (Iraq), Ur (Iraq), Samarra (Iraq), Hamadan (Iran), Harsin (Iran), Kermanshah (Iran), and Shiraz (Iran)." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_12 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_12_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.11, which includes one sketchbook (Skizzenbüch XXVI), provides records of Herzfeld's observations on archaeological remains, prehistoric artifacts and decorative motifs, some from the Hahn Collection." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_13 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_13_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.12, which includes five sketchbooks (Skizzenbücher XXVII, XXVIII, XXIX, XXX, and XXXI), provides records of Herzfeld's observations on archaeological remains, reliefs and inscriptions, prehistoric artifacts and decorative motifs related to several archaeological sites in Persia and Mesopotamia, as well as to the prehistoric mound of Tepe Giyan (Iran) in particular." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_14 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_14_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.13, which includes four sketchbooks (Skizzenbücher XXXII, XXXIII, XXXIV, and XXXV), provides records of Herzfeld's observations on inscriptions, archaeological remains, architecture, and decorative motifs related to Aleppo (Syria), Damascus (Syria), Hama (Syria), Hims (Syria), and Ma'arat al-Nu'man (Syria)." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_15 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_15_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Ernst Herzfeld Papers, Series 2: Sketchbooks" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.01, which includes eight sketchbooks (Skizzenbücher I, II, III, IV, V, VI, VII, and VIII), covers Herzfeld's travels and surveys of the most major archaeological sites in Persia from 1923 to 1924." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_3 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_3_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.02, which includes three sketchbooks (Skizzenbücher IX, X, and XI), provides a succinct but seemingly comprehensive view of the site of Pasargadae where Herzfeld formal excavations only occupied twenty-eight days in April and May 1928." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_4 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_4_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.03, which includes one sketchbook (Skizzenbüch XII), in part covers Herzfeld's years of travel and survey of most major archaeological sites in eastern Iran (Khorasan, Persia) in 1925." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_5 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_5_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.04, which includes one sketchbook (Skizzenbüch XIII), in part covers Herzfeld's years of travel and survey of most major archaeological sites in eastern Iran (Sistan-Quhistan, Persia) in 1925." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_6 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_6_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.05, which includes one sketchbook (Skizzenbüch XIV), provides records of Herzfeld's observations related to Isfahan (Iran), Kerman (Iran), Na'in (Iran), and Saweh (Iran)." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_7 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_7_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.06, which includes one sketchbook (Skizzenbüch XV), provides records of Herzfeld's observations during a campaign of excavation at Kuh-e Khwaja (Iran) and Sistan (Iran), carried out in February and March 1929." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_8 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_8_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.07, which includes seven sketchbooks (Skizzenbücher XVI, XVII, XVIII, XIX, XX, XXI,and XXII), covers the field activities of the Persepolis Expedition, including excavations at Istakhr (Iran), Naqsh-i Rustam (Iran), and the terrace complex of Persepolis (Iran). The archaeological work was initiated by Professor Ernst Herzfeld in Spring 1931, until he was removed from his position as expedition director at the end of 1934." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6806_scopecontent_9 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6806_scopecontent_9_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 02.08, which includes one sketchbook (Skizzenbüch XXIII), provides records of Herzfeld's observations on archaeological remains related to Split (Croatia)." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6808_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref6808_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents This subseries includes sketchbooks I through VIII." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6809_arrangement_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Arrangement" ;
    crm:P148_has_component kg:note_ref6809_arrangement_0_p_0 ;
    crm:P2_has_type mbs:Arrangement ;
    rdf:value "Arrangement Sketchbooks, housed in document boxes and stored on shelves, are organized by Joseph Upton into 13 subject categories." ;
    mbs:noteType mbs:Arrangement .

