    crm:P148_has_component kg:note_ref6942_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Original handwritten title on cover reads: \"Ernst Herzfeld; Skizzenbuch IV: Persien, 1923\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref6942_scopecontent_10 a crm:E33_Linguistic_Object ;
