    rdf:value "Local Numbers FSA A.06 02" ;
    mbs:noteType mbs:OddNote .

kg:note_ref6806_odd_1 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref6806_odd_1_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Sketchbooks titles are provided by Xavier Courouble, FSg Archives cataloger, based on Ernst Herzfeld's publications, handwritten sketchbooks captions and Joseph Upton's Catalogue of the Herzfeld Archive." ;
    mbs:noteType mbs:OddNote .

kg:note_ref6806_odd_2 a crm:E33_Linguistic_Object ;
