    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - SK-33 is the the thirty-third of a series of thirty-five sketchbooks (Skizzenbücher), in which Ernst Herzfeld recorded his observations on inscriptions, archaeological remains, architecture, and decorative motifs related to Damascus (Syria)." ;
    mbs:noteType mbs:ScopeContent .

