kg:component_ref6667 a crm:E73_Information_Object,
        mbs:ArchivalComponent ;
    rdfs:label "N-85: \"Afghanistan -Ostpersien I. 1924-1925\"" ;
    dct:identifier "1.6" ;
    crm:P102_has_title kg:title_ref6667 ;
