kg:note_ref6367_odd_1 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref6367_odd_1_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Additional information from staff reads, \"The handwritten text of the Journal in German was transliterated and reviewed by Ernst Herzfeld's former collaborator, Friedrich Krefter, with the assistance of his wife, Maria Krefter. Please contact the Archives for digital access to the transliterated copy.\"" ;
    mbs:noteType mbs:OddNote .

