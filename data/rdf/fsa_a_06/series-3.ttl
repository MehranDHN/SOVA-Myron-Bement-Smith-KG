kg:component_ref8354 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-101: \"Damaskus, Umayyaden Moschee\" Contains notes by René Dussaud on the mosque; also a notebook of Aleppo inscriptions and notes" ;
    dct:identifier "FSA A.6 03.101" ;
    crm:P102_has_title kg:title_ref8354 ;
    crm:P129_is_about kg:concept_art_of_the_islamic_world,
        kg:concept_lcsh_sh85006507 ;
    crm:P1_is_identified_by kg:title_ref8354 ;
    crm:P2_has_type aat:300027182,
        kg:concept_aat_300264354 ;
    crm:P3_has_note "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Notebooks were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.) for 131 notebooks, including four ledgers and eight travel journals. Upton has given this notebook an accession number, N-101, related to the series he created for the notebooks, probably following Herzfeld's original organization.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers Ernst Herzfeld Papers; N-101 FSA A.6 03.101",
        "Scope and Contents - Handwritten caption, in French, on large envelope reads, \"Grande mosquée Damas; Documents [René] Dussaud (133 avenue Malakoff Paris); donnés par lui en 1911, sans conditions, darin befindet sich auch mein Tagebuch. [Signed by] Max Van Berchem, Crans, Céligny.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-101 reads, \" \"Damaskus, Umayyaden Moschee\" Contains notes by René Dussaud on the mosque; also a notebook of Aleppo inscriptions and notes .\"",
        "Scope and Contents Ernst Herzfeld Papers, Series 3: Notebooks; René Dussaud's Notes, Given to Max Van Berchem in 1911, Regarding the Great Mosque of Damascus (Syria) as well as the City's Other Madrasas and Mashhads (N-101)" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref8354 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref8354_arrangement_0,
        kg:note_ref8354_odd_0,
        kg:note_ref8354_odd_1,
