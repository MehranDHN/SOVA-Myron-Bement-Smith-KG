        kg:note_ref8064_odd_0,
        kg:note_ref8064_odd_1,
        kg:note_ref8064_scopecontent_0,
        kg:note_ref8064_scopecontent_1,
        kg:note_ref8064_scopecontent_2,
        kg:place_tgn_1000004 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref8064> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc31eb2b11c-484a-4208-807a-5480d97e441f> ;
    mbs:archivalLevel "file" ;
    mbs:digitizationKind mbs:none ;
    mbs:digitized false ;
    mbs:eadRef "ref8064" ;
    mbs:hasLinguisticObject kg:note_ref8064_arrangement_0,
