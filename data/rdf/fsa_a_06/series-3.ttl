kg:physical_ref8633 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: \"Sent from Cairo\"" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc38a95822e-588b-481e-9993-485a2fa5580a> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8634 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: 1. Folder marked \"Pahlavi\" contains studies of Pahlavi inscriptions, such as monograms on bullae, and what appears to be a preliminary draft of an article attempting to elucidate the relationships between monumental and cursive scripts and Pahhlavik, Parsik and book Pahlavi. It starts: \"Die Awesta-schrift ist, trotzdem sie die einzelnen Buchstaben nicht verbindet, eine Schreibschrift, eine Kursive, keine Denkmalschrift, keine monumental.\"" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3357d7073-21a2-4f44-89e2-b5b4edcbb316> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8635 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: 2. Envelope containing pages apparently from a draft of The Persian Empire, Chaps. XIV-XV dealing with the Achaemenian Satrapies as reflected in the figures of Tribute-bearers and Throne-bearers at Bistun, Persepolis and Naqsh-i Rustam" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3d60beffc-1149-4a00-ba4c-1cf74796739a> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8636 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: 3. Folder marked \"Aramaeisches\". Contains tracings and photographs of Aramaic inscriptions from various sources and a Table comparing Hebrew letters of the alphabet with those found in other inscriptions including Avroman, Naqsh-i Rustam, Hajjiabad, Paikuli, Persepolis and Taq-i Bustan" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3ef83b817-9d88-46d3-8c12-fa42b792d299> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8637 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: 4. Folder containing photographs and blueprints of squeezes of the Kartīr inscription, Naqsh-i Rustam" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc381cafb35-a329-4e11-8f59-b45f6db22bfc> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8638 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: 5. Folder marked \"File III\" containing photographs and blueprints of squeezes of inscriptions at (1) Sarpul (cuneiform), (2) Naqsh-i Rajab (Kartīr), (3) Hajjiabad, (4) Naqsh-i Rustam (Ardashir), (5) Arabic inscriptions at Persepolis" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3742cc1e2-de9f-4d0f-8233-2dae9870297c> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8639 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: 6. Folder marked \"File II\" contains reading notes on \"Tabula Pentisgerdana (?), Tomascheck; also miscellaneous loose sheets found in \"Corpus Inscriptionum Partharicarum\", including Sasanian seal-stones, Hephthalite coins, Greek and cuneiform inscriptions; and an envelope with Oriental Institute photographs of stone blocks inscribed in Greek from the Fratadara temple, Persepolis (see SK-XIX. p.9 and 15); and a photo of three cylinder seals" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3b8bb0ec4-7fa3-4b03-91d3-0fa8acb17a51> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8640 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: 7. Folder containing a copy of the Pahlavi inscription on the Ka'ba at Naqsh-i Rustam (either for Ghirshman or by him)" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3cd1a822c-0a90-476d-be2a-4352d9414151> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8641 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-127: 8. Black, loose-leaf notebook marked \"A Corpus of Parthian and Sasanian Inscriptions, Texts, Transcriptions, Translations\". A note in the hand of Pere de Menasce says: \"E.H. worked on this book up to the time of his death. The Illustrations are in Albums, I, II, III, IV.\" For the Albums see N-129--132" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3012eadd5-381f-4862-bd23-ec64f62fe24b> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8642 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 1. A brown envelope marked \"Pahlavi Material List\"." ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc30b1f8c23-e39c-4421-be46-dc14294661ce> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8644 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 2. A folder of heavy white paper with the Kartīr inscription at Sar Mashhad, enclosing 4 photographs (with blueprints) of sections of the inscription; a tracing of an unidentified amulet with page giving inscriptions in two Pahlavi scripts: cursive and book Pahlavi; 2 pages of what appear to be Pahlavi inscriptions on bullae. The folder is marked \"All these to be microfilmed for Rev, J. de Menasce\"" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3aca62216-241b-40ca-8c57-e82b249b324f> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8645 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 3. Manila folder containing: (1) the Pahlavi and Greek texts of the Ka'ba inscription, Naqsh-i Rustam; (2) a comparative table of transliterated texts of the Kartīr inscriptions at Sar Mashhad, Naqsh-i Rustam. K i Z (Ka'ba) and Naqsh-i Rajab" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc31a64ae9a-c613-4c61-ae85-00e77dfb736d> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8646 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 4. Tracings of 26 Paikuli block inscriptions, and photographs of 126 (all but three) of the small transcripts of the blocks from Herzfeld's last copy. Those missing are (1) transcript of a seal inscription, (2) of an unnumbered block E 1, and (3) of a new unnumbered block marked \"before D-5.\" See No.13 for the small transcripts. On the back of each photograph is noted the number of the block and its location in the series of blocks" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc36d421fb0-e21e-4661-9c6f-5a18345006a3> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8647 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 5. Manila folder marked \"Paikuli, the Sasanian Version. Blueprints of theunpublished squeezes. The numbers on the back refer to those given by E.H. to his latest copies of the blocks\"" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc38f79a5d4-b128-4dee-ae6d-31106bfdc218> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8648 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 6. Manila folder of blueprints of unpublished Pahlavik or Parthian squeezes. A note on the cover (which also includes folder 5) by P. de Menasce says: \"Blueprints. These are photographs of E.H.'s latestsqueezes mostly unpublished or photographed anew.\" The numbers on the backs are from Herzfeld's last copy" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc37b9089ad-7566-4608-9e0e-b8ab62570ba3> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8649 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 7. Manila folder with blueprints of Kartīr inscription, Naqsh-i Rajab; large photographs of (1) Greek inscription at Sarpul, (2) Kartīr inscription, Naqsh-i Rajab, (3) (right side of Main Staircase, Persepolis, and (4) Pahlavi and Greek inscriptions on horse's rump, Naqsh-i Rustam" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc356348796-a664-499b-938e-880f183125ce> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8650 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 8. Photographic negative of Squeeze 93, 9 × 11\". Paikuli, p.109. Another Neg.4396" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3320f7408-e25a-4252-aad0-b5ba08fbda98> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8651 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 9. Photographic negative of Squeeze 93, 9 × 11\". Paikuli, p.145. Another Neg.4317" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc329dc79bc-151c-436e-8876-289253284992> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8652 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 10. Long manila envelope contains small drawings of individual Paikuli blocks and long strips of transcript, apparently showing an attempt to reconstruct the lines of the inscriptions. Envelope also contains tracing of a coin of Phraates IV with Greek inscriptions" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3c5fcf22c-62fb-4eaa-bfc0-deb0e9fe3364> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8653 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 11. (\"Parthian\") A record of the Pahlavik stones as prepared by Rawlinson in Hebrew script with Herzfeld's notations of changes" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc32547b32a-3ecf-4cb4-a880-24e7ac844a90> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8654 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 12. (\"Sasani\") Similar record of Rawlinson's list of the Parsik stones in Hebrew with, in some cases, Herzfeld's transliteration into Pahlavi. Also contains 11 slips of blocks with existing text supplemented by Rawlinson's copies" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3fc7de264-200c-4465-ba99-99b9c1b32a51> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8655 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 13. Manila envelope of Institute of Advanced Study" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3c112f706-3efa-435e-a0dc-cad824a97bb5> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8657 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-128: 14. (\"Paikuli II, 1923, 1--7 Juni\") This is the field sketchbook of Herzfeld's last trip to Paikuli with sketches of new inscriptions and notes. Also contains sketch of an inscribed Sasanian bulla from Sarpul" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3d2a8c190-8ac4-4a55-9fda-ff9d059ff358> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8658 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-129: Contains four large albums of photographs and blueprints" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc373149a99-eb04-42eb-bc1f-a292363a4643> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8659 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-129: 1. Album marked Album I, \"Pahlavi Inschriften b.\" It bears a notation by de Menasce: \"Fragments of the Paikuli inscription newly washed and newly found stones photographed (since the publication of Paikuli)....\" Includes photographs of stones and some blueprints of tracings. At the end of the Album are tracings of squeezes of sections of the Pahlavi inscription at Sar Mashhad" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3915274c5-042c-4324-8fca-ef046e5dd5b2> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8660 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-129: 2. Marked Album II \"Pahlavi Inschriften c.\" A notation by Prof. de Menasce reads: \"The Paikuli Inscription, Sasanian (Parsīk) as published by E.H.\" Photographs of stones and blueprints of tracings. The following tracings have corrections made by Herzfeld: All and A12 (p.5), B7 (p.11), B14 (p.18), F6 (p.38), H2 (p.47)" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3ae8e1bf1-2d9a-4a91-bd2e-c5ee29addcba> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8661 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-129: 3. Album III. Notation by de Menasce reads \"22 leaves, pages numbered from 1 to 44; on the cover \"Corpus Inscriptionum Parthicarum\" (this title does not correspond to the contents): the former title, almost erased, seems to have been \"Pahlavi Inschriften a.\" The Inventory by de Menasce (N-128, No. 1) gives a page by page description of the contents of Album II consisting almost exclusively of Aramaic and Pahlavi inscriptions from Sarpul, Naqsh-i Rustam, Naqsh-i Rajab, Hajjiabad, Taq-i Bustān, etc. through that on the Mil-i Radkan" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc34081a450-5088-4e8e-8b6e-b103a1d92f97> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8662 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-129: 4. Album IV. Notation by Prof. de Menasce reads: \"The Paikuli Inscription, Parthian (Pahlavik) as published by E.H.\" Photographs of stones and blueprints of tracings. The following tracings have corrections by Herzfeld: A'11 (p.23), B'1 (p.24), B'11 (p.28), B'9 (p.29), C'1 (p.31), C'3 (p.34), C'4 (p.35), C'6 (p.36), C'9 (p.37), D'7 (p.41), E'7 (p.45), D'12 (p.46), E'14 (p.47), F'2 (p.49), G'3 (p.58), G'6 (p.60). The page numbers refer to the Album." ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3b1efab13-8e66-45d8-bd4a-0e87890a1fc6> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8664 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-131: A. Professor Herzfeld's personal correspondence: letters A-L,with index" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3cabb0bcd-606a-4180-b11c-5acc116b058b> ;
