kg:component_ref29949 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Ernst Herzfeld Papers, Series 3: Notebooks; Sassanid Seals with Pahlavi Inscriptions (N-1)" ;
    dct:identifier "FSA A.6 03.001" ;
    crm:P102_has_title kg:title_ref29949 ;
    crm:P129_is_about kg:concept_ancient_near_eastern_art,
        kg:concept_inscriptions_pahlavi,
        kg:concept_lcsh_sh85005283,
        kg:concept_lcsh_sh85005757,
        kg:concept_lcsh_sh85006507,
        kg:concept_lcsh_sh85066566,
        kg:concept_middle_persian_language,
        kg:concept_seals_numismatics ;
    crm:P1_is_identified_by kg:title_ref29949 ;
    crm:P2_has_type aat:300264354,
        kg:concept_aat_300264354 ;
    crm:P3_has_note "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Notebooks were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.) for 131 notebooks, including four ledgers and eight travel journals. Upton has given this notebook an accession number, N-1, related to the series he created for the notebooks, probably following Herzfeld's original organization.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers Ernst Herzfeld Papers; N-1 FSA A.6 03.001",
        "Scope and Contents - FSA A.6 03.001, on which Joseph Upton's classification mentions \"N-1\", provides sketches and notes on various Sassanid (Sasanian) seals with Pahlavi Inscription.",
        "Scope and Contents - Handwritten caption, in pencil (probably by joseph Upton), on front cover reads: \"Sasanian Seals.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-1, p. 1 reads, \"Two Sasanian seals with Pahlavi inscriptions.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-1, p. 11 reads, \"Pahlavi inscriptions from Sasanian seals. Five.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-1, p. 13 reads, \"Pahlavi inscriptions from Sasanian seals. Two.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-1, p. 3 reads, \"Kufic seal: Abū Shujā and (on Rev.) Muhammad ibn al-HusaÃ&#xad;h ibn al-Muzaffar.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-1, p. 5 reads, \"Pahlavi inscriptions from Sasanian seals. Four.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-1, p. 7 reads, \"Pahlavi inscriptions from Sasanian seals. Four.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-1, p. 9 reads, \"Pahlavi inscriptions from Sasanian seals. Five.\"" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref29949 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref29949_arrangement_0,
        kg:note_ref29949_odd_0,
        kg:note_ref29949_odd_1,
        kg:note_ref29949_scopecontent_0,
        kg:note_ref29949_scopecontent_1,
        kg:note_ref29949_scopecontent_2,
        kg:note_ref29949_scopecontent_3,
        kg:note_ref29949_scopecontent_4,
        kg:note_ref29949_scopecontent_5,
