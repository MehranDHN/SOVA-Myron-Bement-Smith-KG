kg:component_ref8286 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-78: Quotations in Greek from Appollionius of Rhodes and Aeschylus; also, in German, from Ed. Meyer, regarding manual workers, such as smiths, carpenters" ;
    dct:identifier "FSA A.6 03.078" ;
