    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Ernst Herzfeld Papers, Series 3: Notebooks; List of Various Inscriptions, mostly Middle Persian, and List of Coats of Arms and Headgears on Sassanid Relief sculptures (N-9)" ;
    mbs:noteType mbs:ScopeContent .

