kg:component_ref8596 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-115: Entries from Sept. 1-14th, 1905 in Gothic script. Beginning of trip from Schergat, reported in Journal N-81" ;
    dct:identifier "FSA A.6 03.115" ;
    crm:P102_has_title kg:title_ref8596 ;
    crm:P129_is_about kg:concept_description_and_travel,
        kg:concept_lcsh_sh85006507 ;
    crm:P1_is_identified_by kg:title_ref8596 ;
    crm:P2_has_type aat:300027182,
        kg:concept_aat_300264354,
        kg:concept_diaries ;
    crm:P3_has_note "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Travel Journals were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 1: Travel Journals, 1905-1928) for eight travel journals. For some reason, Upton has given this journal an accession number related to the series he created for the notebooks (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.), probably following Herzfeld's original organization.",
        "General - Additional information from staff reads, \"The handwritten text of the Journal in Gothic script was first transliterated by Mrs. Franz Pariser and later reviewed by Ernst Herzfeld's former collaborator, Friedrich Krefter. Please contact the Archives for digital access to the transliterated copy.\"",
        "Local Numbers Ernst Herzfeld Papers, N-115 FSA A.6 03.115",
        "Scope and Contents - FSA A.6 03.115, on which Joseph Upton's classification mentions \"N-115\", provides an account of the first fourteen days of an expedition (September 2 to November 18, 1905) from Assur (Iraq) to Shiraz (Iran).",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-115 reads, \"Entries from Sept. 1-14th, 1905 in Gothic script. Beginning of trip from Schergat, reported in Journal N-81.\"",
        "Scope and Contents Ernst Herzfeld Papers, Series 3: Notebooks; Diary (Fourteen First Days) of an Expedition from Assur (Iraq) to Shiraz (Iran)" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref8596 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref8596_arrangement_0,
        kg:note_ref8596_odd_0,
        kg:note_ref8596_odd_1,
        kg:note_ref8596_scopecontent_0,
        kg:note_ref8596_scopecontent_1,
        kg:note_ref8596_scopecontent_2,
        kg:place_tgn_1000004,
        kg:place_tgn_1000118,
        kg:place_tgn_7000231 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref8596> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc397b861e9-b00f-4a77-9b8c-d8042d2ca678> ;
    mbs:archivalLevel "file" ;
    mbs:digitizationKind mbs:none ;
    mbs:digitized false ;
    mbs:eadRef "ref8596" ;
