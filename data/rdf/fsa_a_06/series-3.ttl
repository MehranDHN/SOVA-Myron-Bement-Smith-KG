    owl:sameAs <https://n2t.net/ark:/65665/dc3d8022e28-5f45-4ca6-9276-7f25506e39c9> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8628 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-126: 3. Manilla envelope with following correspondence:" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc30d7df3c7-68b0-4b63-a5f0-aa2c65cb6ebb> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8630 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-126: 4. Large mounted print. Stolze photo. Naqsh-i Rustam, Sasanian combats" ;
