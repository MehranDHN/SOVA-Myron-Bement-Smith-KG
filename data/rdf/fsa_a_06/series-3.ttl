kg:component_ref8247 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-40: Two pen and water-color sketches of Assur, 1904" ;
    dct:identifier "FSA A.6 03.040" ;
    crm:P102_has_title kg:title_ref8247 ;
    crm:P129_is_about kg:concept_ancient_near_eastern_art,
