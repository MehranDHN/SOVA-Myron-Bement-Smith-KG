kg:component_ref8090 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-11: Sasanian seal-stones, many with inscriptions. P.1 is marked \"Calcutta,\" but it is uncertain whether that refers to all pages from 1 to 45. The loose slips are of objects mostly in European museum collections" ;
    dct:identifier "FSA A.6 03.011" ;
    crm:P102_has_title kg:title_ref8090 ;
    crm:P129_is_about kg:concept_ancient_near_eastern_art,
