kg:physical_ref8632 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-126: 6. Large mounted print. Aleppo, Bab Antakiya" ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc339512693-3ccd-4d29-bf91-44f24f58a55d> ;
