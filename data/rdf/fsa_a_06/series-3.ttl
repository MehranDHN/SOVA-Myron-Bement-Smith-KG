kg:note_ref8144_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents note" ;
    crm:P148_has_component kg:note_ref8144_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents note Lists photographs taken in Turkey, Hatra, etc. 1916 and in Persia, 1925 (includes prints in Photo Files 10 and 11); also lists contents of cases of frescoes and stucco from Kūh-i Khwāja in Bartus's handwriting" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref8144_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref8144_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 03.029, on which Joseph Upton's classification mentions \"N-29\", provides first a list of photographs from Cilicia (I), Tell Halaf (II), Mosul (III and IV), Hatra (V), Erbil (VI), Sitak (VII), Sardasht (VIII and IX), east of Rania (X), vicinity of Dukkan (XI), vicinity of Bana (XII), the Kuh-e Owraman Range (XIII and XIV), Kale i Kuhna (XV), and Dinawar (XVI); second a list of photographs taken at Taq i Bustan in 1913; third a list of photographs taken in 1925 during an expedition from Zahedan, in the province of Sistan and Baluchestan (Iran), to Mashhad (Iran) in the province of Khorasan, and ultimately to Tehran (Iran). The photographs are from Shahristan (Iran), Zahedan (Iran), Qasimabad (Iran), Birjand (Iran), Khargird (Iran), Radkan (Iran), Tus (Iran), Sangbast (Iran), Nishapur (Iran), Sabzawar (Iran), Khosrogird (Iran), Bistam (Iran), Damghan (Iran), and Semnan (Iran), as well as the ruins at Kuh-e Khwaja (Iran), followed by two lists contents of cases of frescoes and stucco from Kuh-i Khwaja in Theodore Bartus's handwriting." ;
    mbs:noteType mbs:ScopeContent .

