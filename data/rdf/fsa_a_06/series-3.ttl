    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30019_scopecontent_9_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-128, folder 10 reads, \"Long manila envelope contains small drawings of individual Paikuli blocks and long strips of transcript, apparently showing an attempt to reconstruct the lines of the inscriptions. Envelope also contains tracing of a coin of Phraates IV with Greek inscriptions.\"" ;
    mbs:noteType mbs:ScopeContent .

