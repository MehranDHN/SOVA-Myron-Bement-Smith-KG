        kg:place_tgn_1000004,
        kg:place_tgn_7000231 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref8084> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3d58ab566-7755-4a92-99e4-8073575ca9d3> ;
    mbs:archivalLevel "file" ;
    mbs:digitizationKind mbs:none ;
    mbs:digitized false ;
    mbs:eadRef "ref8084" ;
