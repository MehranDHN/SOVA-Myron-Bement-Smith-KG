    rdf:value "Scope and Contents Ernst Herzfeld Papers, Series 3: Notebooks; Articles, Correspondence, Notes and Sketches related to Various Cuneiform Inscriptions (N-113)" ;
    mbs:noteType mbs:ScopeContent .

