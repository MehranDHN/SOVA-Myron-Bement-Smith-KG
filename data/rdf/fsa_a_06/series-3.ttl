kg:physical_ref8668 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-131: E. E-1--116 Personal correspondence between Herzfeld's sister (Mrs. Charlotte Bradford) and Dr. Ettinghausen, Dec.1, 1947--Dec.1, 1953. Includes correspondence dealing with the completion of the Aleppopublications in Cairo and the Samarra, vol.VI in Germany" ;
    crm:P2_has_type aat:300027182 ;
