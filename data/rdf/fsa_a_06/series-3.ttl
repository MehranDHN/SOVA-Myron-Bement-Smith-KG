kg:component_ref8185 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-31: Contains extract of Arabic text of Ibn 'Asākir regarding Great Mosque of Damascus. Given to Max van Berchem by Rene Dussaud in 1911. Also extracts from Berlin Safavi Ms. in Arabic regarding Yelbogha" ;
    dct:identifier "FSA A.6 03.031" ;
    crm:P102_has_title kg:title_ref8185 ;
    crm:P129_is_about kg:concept_art_of_the_islamic_world,
