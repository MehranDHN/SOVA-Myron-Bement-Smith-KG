    rdfs:label "Scope and Contents note" ;
    crm:P148_has_component kg:note_ref8592_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents note Folder also contains: (1) photo from A.U.Pope of inscription of Masjid-i Jam'i, Qazvin; (2) inscriptions from mosque and minaret at Barsian; and (3) unidentified tracings of Kufic inscriptions, possibly at Persepolis" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref8592_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
