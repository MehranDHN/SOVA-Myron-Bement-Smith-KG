kg:note_ref8350_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents note" ;
    crm:P148_has_component kg:note_ref8350_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents note [Drafts?] for an article on Fire Temples, including Masjid-i Sulaiman (Nov. 1928); Takht-i Rustam (Sept. 1923); Kūh-i Khwāja (1924, 1929); Shahristan (Feb. 11--4, 1925); Firuzabad (Ardashir Khurrah) (March, 1924); Qaleh-i Dukhtar (1925); and Girah (Sar Mashhad) (Mar. 29, 1924). A revised version starts on p.16. Includes quotations from N-84, for instance, on pp.2--" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref8350_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref8350_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 03.098, on which Joseph Upton's classification mentions \"N-98\", provides two copies, a draft and a revised version, of an article on antique fire temples." ;
    mbs:noteType mbs:ScopeContent .

