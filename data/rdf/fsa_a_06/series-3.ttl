kg:note_ref8596_odd_1 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref8596_odd_1_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    rdf:value "General - Additional information from staff reads, \"The handwritten text of the Journal in Gothic script was first transliterated by Mrs. Franz Pariser and later reviewed by Ernst Herzfeld's former collaborator, Friedrich Krefter. Please contact the Archives for digital access to the transliterated copy.\"" ;
    mbs:noteType mbs:OddNote .

kg:note_ref8596_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref8596_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 03.115, on which Joseph Upton's classification mentions \"N-115\", provides an account of the first fourteen days of an expedition (September 2 to November 18, 1905) from Assur (Iraq) to Shiraz (Iran)." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref8596_scopecontent_1 a crm:E33_Linguistic_Object ;
