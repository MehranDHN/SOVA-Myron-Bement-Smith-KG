        kg:note_ref29949_scopecontent_8,
        kg:place_tgn_1000004,
        kg:place_tgn_7000231 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref29949> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3ea27c6ef-3dfa-4a7c-ac12-df56b1c22c1f> ;
    mbs:archivalLevel "item" ;
    mbs:digitizationKind mbs:none ;
    mbs:digitized false ;
    mbs:eadRef "ref29949" ;
