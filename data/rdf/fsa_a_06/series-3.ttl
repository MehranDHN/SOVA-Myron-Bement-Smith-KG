kg:component_ref8340 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-88: Contains cuneiform inscriptions from Assur; Greek inscriptions from Cilicia; notes on Islamic architecture, including the Mustansiriyya in Baghdad; itinerary Qyzribat-Khaniqin with notes on mosque in Kerkuk; itinerary Hamadan-Enzeli; extract from van Berchem's Journal on the Great Mosque at Damascus; extract from Enno Littmann's article (in Italian) on the inscriptions in Harran and Zebed. With the notebook are a few pages of notes related to the Damascus mosque" ;
    dct:identifier "FSA A.6 03.088" ;
    crm:P102_has_title kg:title_ref8340 ;
    crm:P129_is_about kg:concept_aat_300007391,
        kg:concept_aat_300263552,
        kg:concept_ancient_near_eastern_art,
        kg:concept_art_of_the_islamic_world,
        kg:concept_cuneiform_inscriptions,
        kg:concept_inscriptions_arabic,
        kg:concept_inscriptions_greek,
        kg:concept_lcsh_sh85006507,
        kg:concept_lcsh_sh85066566 ;
    crm:P1_is_identified_by kg:title_ref8340 ;
    crm:P2_has_type aat:300027182,
        kg:concept_aat_300264354 ;
    crm:P3_has_note "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Notebooks were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.) for 131 notebooks, including four ledgers and eight travel journals. Upton has given this notebook an accession number, N-88, related to the series he created for the notebooks, probably following Herzfeld's original organization.",
        "Local Numbers Ernst Herzfeld Papers, N-88 FSA A.6 03.088",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-88 reads, \"Contains cuneiform inscriptions from Assur; Greek inscriptions from Cilicia; notes on Islamic architecture, including the Mustansiriyya in Baghdad; itinerary Qyzribat-Khaniqin with notes on mosque in Kerkuk; itinerary Hamadan-Enzeli; extract from van Berchem's Journal on the Great Mosque at Damascus; extract from Enno Littmann's article (in Italian) on the inscriptions in Harran and Zebed. With the notebook are a few pages of notes related to the Damascus mosque.\"",
        "Scope and Contents Ernst Herzfeld Papers, Series 3: Notebooks; Notes on Various Inscriptions and Architecture; Two itineraries; as well as Transcriptions from Max Van Berchem's Sketchbook on the Great Mosque of Damascus (Syria) and an Article of Enno Littmann on Inscriptions in Zebed (Syria) and Haran (Syria) (N-88)" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref8340 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref8340_arrangement_0,
        kg:note_ref8340_odd_0,
        kg:note_ref8340_scopecontent_0,
        kg:note_ref8340_scopecontent_1,
        kg:place_baghdad_iraq,
        kg:place_damascus_syria,
        kg:place_tgn_1000004,
        kg:place_tgn_1000118,
        kg:place_tgn_1000146 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref8340> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc37eeaf927-6d76-4800-9174-795699424f39> ;
    mbs:archivalLevel "file" ;
    mbs:digitizationKind mbs:none ;
    mbs:digitized false ;
    mbs:eadRef "ref8340" ;
    mbs:hasLinguisticObject kg:note_ref8340_arrangement_0,
        kg:note_ref8340_odd_0,
        kg:note_ref8340_scopecontent_0,
        kg:note_ref8340_scopecontent_1 ;
    mbs:hasParentComponent kg:component_ref8055 ;
    mbs:hasPhysicalUnit kg:physical_ref8340 ;
    mbs:sovaUrl "https://sova.si.edu/record/fsa.a.06/ref8340"^^xsd:anyURI .

kg:component_ref8345 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-93: \"Katalog meiner Bibliothek I E.Herzfeld 1918.\" Alphabetical catalogue by authors" ;
    dct:identifier "FSA A.6 03.093" ;
    crm:P102_has_title kg:title_ref8345 ;
    crm:P129_is_about kg:concept_lcsh_sh85006507 ;
    crm:P1_is_identified_by kg:title_ref8345 ;
    crm:P2_has_type aat:300027182,
        kg:concept_aat_300264354 ;
    crm:P3_has_note "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Notebooks were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.) for 131 notebooks, including four ledgers and eight travel journals. Upton has given this notebook an accession number, N-93, related to the series he created for the notebooks, probably following Herzfeld's original organization.",
        "Local Numbers Ernst Herzfeld Papers, N-93 FSA A.6 03.093",
        "Scope and Contents - Additional information from staff reads: \"FSA A.6 03.093 covers part I of Herzfeld personal library; FSA A.6 03.094 covers part II.\"",
        "Scope and Contents - FSA A.6 03.093, on which Joseph Upton's classification mentions \"N-93\", provides a long list of archaeological publications included in Ernst Herzfeld personal library. The list, written in 1918 probably by Herzfeld, is organized by authors in alphabetical order and contains purchased prices in German Mark currency following each entry.",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-93 reads, \"\"Katalog meiner Bibliothek I E.Herzfeld 1918.\" Alphabetical catalogue by authors.\"",
