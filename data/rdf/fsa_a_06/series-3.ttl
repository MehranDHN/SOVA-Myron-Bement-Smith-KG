    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents Ernst Herzfeld Papers, Series 3: Notebooks; Inventory of Objects in Herzfeld Collection (Continuation of N-89)" ;
    mbs:noteType mbs:ScopeContent .

