kg:component_ref8140 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-26: Epigraphical studies with references in Pahlavi, Persian, Hebrew, Greek and Latin" ;
    dct:identifier "FSA A.6 03.026" ;
    crm:P102_has_title kg:title_ref8140 ;
    crm:P129_is_about kg:concept_ancient_near_eastern_art,
