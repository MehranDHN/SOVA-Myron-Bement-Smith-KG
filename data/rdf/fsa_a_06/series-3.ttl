kg:note_ref8344_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref8344_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - The fourth of a series of four inventory books, which displays two separate inventories of objects. The first list describes archaeological remains, prehistoric artifacts and antiquities which were collected during a session of excavations at Pasargadae in April and May 1928, carried out by Ernst Herzfeld, assisted by the architect Friedrich Krefter. The second list, without dates, enumerates prehistoric artifacts and antiquities collected, acquired, or observed in Baghdad, Hamadan, Harsin, Kermanshah, Nihavand, Tehran, and possibly Ur." ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref8344_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref8344_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from staff reads: \"For the Pasargadae finds journal, Herzfeld has diversely applied to each inventory number, which are ranging from 1 to 34, the excavated building or site; dates; sketches; physical descriptions; and cross-references to additional materials (glass negatives, sketchbooks, and paper squeezes) within the Ernst Herzfeld Papers.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref8344_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref8344_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Additional information from staff reads: \"For the prehistoric objects, Herzfeld has diversely applied to each inventory number, which are ranging from 1 to 60 (in addition of 19 objects un-numbered), a place of provenance and/or acquisition; sketches; and physical descriptions.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref8344_scopecontent_3 a crm:E33_Linguistic_Object ;
