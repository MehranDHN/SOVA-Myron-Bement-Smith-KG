kg:note_ref8358_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref8358_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-105 reads, \"Contains bibliographical references to following buildings as well as inscriptions and sketches of some architecture or ornament. Buildings primarily in Damascus, Aleppo, Hamah and Homs (Hims), but also Madrasa Nizamiyya (Khargird), Imam Dur, Dhu-1 Kifl, Masjid-i 'All (Isfahan), Zubair, Kharg and Baba Munir (Fars).\"" ;
    mbs:noteType mbs:ScopeContent .

