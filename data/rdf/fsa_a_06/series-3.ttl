        kg:place_tgn_1000118,
        kg:place_tgn_7011132 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref29954> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3a46e9516-929e-4cdf-8f77-9f6f09ed00b6> ;
    mbs:archivalLevel "item" ;
