    rdfs:label "Ernst Herzfeld Papers, Series 3: Notebooks; Transcription of Various Arabic Inscriptions, Part 2 (N-109)" ;
    dct:identifier "FSA A.6 03.109" ;
    crm:P102_has_title kg:title_ref30014 ;
