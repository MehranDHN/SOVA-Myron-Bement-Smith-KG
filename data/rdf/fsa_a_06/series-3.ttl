kg:component_ref29950 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Ernst Herzfeld Papers, Series 3: Notebooks; Stamp Seals with Various Inscriptions (N-4)" ;
    dct:identifier "FSA A.6 03.004" ;
    crm:P102_has_title kg:title_ref29950 ;
    crm:P129_is_about kg:concept_ancient_near_eastern_art,
        kg:concept_cuneiform_inscriptions,
        kg:concept_inscriptions_arabic,
        kg:concept_inscriptions_aramaic,
        kg:concept_inscriptions_pahlavi,
        kg:concept_lcsh_sh85005757,
        kg:concept_lcsh_sh85006507,
        kg:concept_lcsh_sh85066566,
        kg:concept_middle_persian_language,
        kg:concept_seals_numismatics ;
    crm:P1_is_identified_by kg:title_ref29950 ;
    crm:P2_has_type aat:300264354,
        kg:concept_aat_300264354 ;
    crm:P3_has_note "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Notebooks were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.) for 131 notebooks, including four ledgers and eight travel journals. Upton has given this notebook an accession number, N-4, related to the series he created for the notebooks, probably following Herzfeld's original organization.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers Ernst Herzfeld Papers; N-4 FSA A.6 03.004",
        "Scope and Contents - Handwritten caption, in pencil (probably by joseph Upton), on front cover reads: \"Seals.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 1 reads, \"Pahlavi inscriptions on Sasanian seal-stones.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 10 reads, \"Hebrew (Aramaic ?) inscription on stone fragment.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 11 reads, \"Greek inscription on carnelian.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 12 reads, \"Aramaic (?) inscription.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 13 reads, \"Arabic inscribed ring.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 16 reads, \"Fragment of Aramaic (?) inscription.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 17 reads, \"Hebrew inscription on roll seal.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 2 reads, \"Kufic inscriptions.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 25 reads, \"Pahlavi inscription on seal-stone.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 26 reads, \"Seal of Atūr-Ormizd.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 27 reads, \"Seal of Atūr Ardashīr.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, p. 3 reads, \"Cuneiform inscription on green, flecked stone, British Museum.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, pp. 14 and 15 reads, \"Stamp seals.\"",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-4, pp. 18 and 19 reads, \"Cuneiform fragments.\"",
