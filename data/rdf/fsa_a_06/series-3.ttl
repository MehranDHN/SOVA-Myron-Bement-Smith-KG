    mbs:noteType mbs:ScopeContent .

kg:note_ref8090_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref8090_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-11 reads, \"Sasanian seal-stones, many with inscriptions. P.1 is marked \"Calcutta,\" but it is uncertain whether that refers to all pages from 1 to 45. The loose slips are of objects mostly in European museum collections.\"" ;
    mbs:noteType mbs:ScopeContent .

