kg:note_ref29967_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref29967_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - FSA A.6 03.087, on which Joseph Upton's classification mentions \"N-87\", provides several Pahlavi Inscriptions that were recorded during Herzfeld's expeditions in Persia between 1923 and 1926. These inscriptions are from rock reliefs, ancient palaces, graffitis, coins, bullae and seals." ;
    mbs:noteType mbs:ScopeContent .

