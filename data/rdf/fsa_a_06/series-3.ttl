    crm:P148_has_component kg:note_ref8144_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - Handwritten caption on inside of front cover reads: \"Photographs. Tūrkei, 1916; Persien, 1925. Herzfeld.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref8144_scopecontent_3 a crm:E33_Linguistic_Object ;
