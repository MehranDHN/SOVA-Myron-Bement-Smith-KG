kg:physical_ref8666 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-131: C. Personal financial papers: 1944--1946 D." ;
    crm:P2_has_type aat:300027182 ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3506b554c-37f5-4b84-96ee-786625bbeef5> ;
    mbs:mediaType aat:300027182 .

kg:physical_ref8667 a crm:E22_Human_Made_Object,
        mbs:DocumentaryFile,
        mbs:PhysicalComponent ;
    rdfs:label "N-131: D. D-1--91 Personal correspondence between Herzfeld and Dr. Ettinghausen, Sept.6, 1944.-Dec.29, 1947. Concerns primarily the Damascus articles for Ars Islamica." ;
    crm:P2_has_type aat:300027182 ;
