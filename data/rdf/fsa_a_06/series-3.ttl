kg:digital_fsa_a_06_ref8342 a crmdig:D1_Digital_Object,
        mbs:PdfSurrogate ;
    rdfs:label "N-90: Inventory of Herzfeld's Collection. Nos.1--1864 are, in general, a duplication of the entries in N-89, except for the following: entries 105--120 differ from those in N-89; entry 786 is a stone statuette, in N-89 it is a bronze lamp, each missing in the other volume; 3 unnumbered bowls between entries 1543--44 in N-89 are not in N-90. Also included in N-90 are entries 2885--2980, mostly objects from Nihavand and Harsin" ;
    crm:P2_has_type aat:300028477 ;
    crm:P70i_is_documented_in kg:component_ref8342 ;
    rdfs:seeAlso <https://edan.si.edu/slideshow/viewer/?eadrefid=FSA.A.06_ref8342> ;
    mbs:mediaType aat:300028477 ;
    mbs:pageManifestsPending true ;
    mbs:pdfRequestUrl "https://edan.si.edu/slideshow/viewer/pdf?eadrefid=FSA.A.06_ref8342"^^xsd:anyURI ;
    mbs:viewerUrl "https://edan.si.edu/slideshow/viewer/?eadrefid=FSA.A.06_ref8342"^^xsd:anyURI .

kg:digital_fsa_a_06_ref8343 a crmdig:D1_Digital_Object,
        mbs:PdfSurrogate ;
    rdfs:label "N-91: Inventory of Herzfeld's Collection. Continuation of N-89, Nos. 2032--2884 (No.2032 is used twice, once for another coin in N-89). No prices are entered after 2535. Nos.2261--2511 are headed \"Tepe Giyān, Fall 1926-Spring 1927.\" There are frequent references to photos or sketchbook entries and many of the objects are noted as in the Field Museum, Chicago" ;
    crm:P2_has_type aat:300028477 ;
    crm:P70i_is_documented_in kg:component_ref8343 ;
    rdfs:seeAlso <https://edan.si.edu/slideshow/viewer/?eadrefid=FSA.A.06_ref8343> ;
    mbs:mediaType aat:300028477 ;
    mbs:pageManifestsPending true ;
    mbs:pdfRequestUrl "https://edan.si.edu/slideshow/viewer/pdf?eadrefid=FSA.A.06_ref8343"^^xsd:anyURI ;
    mbs:viewerUrl "https://edan.si.edu/slideshow/viewer/?eadrefid=FSA.A.06_ref8343"^^xsd:anyURI .

kg:digital_fsa_a_06_ref8344 a crmdig:D1_Digital_Object,
        mbs:PdfSurrogate ;
    rdfs:label "N-92: Inventory. Nos. 1--34 headed \"1928. Pasargadae\"; Nos. 1--79 which follow in another series are from Nihavand, Harsin, Baghdad, etc." ;
    crm:P2_has_type aat:300028477 ;
