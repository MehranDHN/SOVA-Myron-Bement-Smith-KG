kg:component_ref8256 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-48: Miscellaneous notes on separate slips of paper include bibliographical references to archaeological sites in Iran, travels in Italy with sketches of inscribed Islamic or earlier objects in public and private collections, epigraphical notes on Pahlavi words, excerpts from items related to Protocols, quotations from Reiner Maria Rilke, applied to Islamic buildings or arts" ;
