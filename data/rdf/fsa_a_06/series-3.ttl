kg:note_ref30018_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30018_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-127, folder 1 reads, \"Marked \"Pahlavi\" contains studies of Pahlavi inscriptions, such as monograms on bullae, and what appears to be a preliminary draft of an article attempting to elucidate the relationships between monumental and cursive scripts and Pahhlavik, Parsik and book Pahlavi. It starts: \"Die Awesta-schrift ist, trotzdem sie die einzelnen Buchstaben nicht verbindet, eine Schreibschrift, eine Kursive, keine Denkmalschrift, keine monumental.\".\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref30018_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30018_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-127, folder 2 reads, \"Envelope containing pages apparently from a draft of The Persian Empire, Chaps. XIV-XV dealing with the Achaemenian Satrapies as reflected in the figures of Tribute-bearers and Throne-bearers at Bistun, Persepolis and Naqsh-i Rustam.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref30018_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30018_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-127, folder 3 reads, \"Marked \"Aramaeisches\". Contains tracings and photographs of Aramaic inscriptions from various sources and a Table comparing Hebrew letters of the alphabet with those found in other inscriptions including Avroman, Naqsh-i Rustam, Hajjiabad, Paikuli, Persepolis and Taq-i Bustan.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref30018_scopecontent_3 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30018_scopecontent_3_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-127, folder 4 reads, \"Photographs and blueprints of squeezes of the Kartīr inscription, Naqsh-i Rustam.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref30018_scopecontent_4 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30018_scopecontent_4_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-127, folder 5 reads, \"Marked \"File III\" containing photographs and blueprints of squeezes of inscriptions at: (1) Sarpul (cuneiform); (2) Naqsh-i Rajab (Kartīr); (3) Hajjiabad; (4) Naqsh-i Rustam (Ardashir); (5) Arabic inscriptions at Persepolis.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref30018_scopecontent_5 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30018_scopecontent_5_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-127, folder 6 reads, \"Marked \"File II\" contains reading notes on \"Tabula Pentisgerdana (?), Tomascheck; also miscellaneous loose sheets found in \"Corpus Inscriptionum Partharicarum\", including Sasanian seal-stones, Hephthalite coins, Greek and cuneiform inscriptions; and an envelope with Oriental Institute photographs of stone blocks inscribed in Greek from the Fratadara temple, Persepolis (see SK-XIX. p.9 and 15); and a photo of three cylinder seals.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref30018_scopecontent_6 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30018_scopecontent_6_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-127, folder 7 reads, \"Copy of the Pahlavi inscription on the Ka'ba at Naqsh-i Rustam (either for Ghirshman or by him).\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref30018_scopecontent_7 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref30018_scopecontent_7_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    rdf:value "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-127, folder 8 reads, \"Black, loose-leaf notebook marked \"A Corpus of Parthian and Sasanian Inscriptions, Texts, Transcriptions, Translations\". A note in the hand of Pere de Menasce says: \"E.H. worked on this book up to the time of his death. The Illustrations are in Albums, I, II, III, IV.\".\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref30019_arrangement_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Arrangement" ;
    crm:P148_has_component kg:note_ref30019_arrangement_0_p_0 ;
    crm:P2_has_type mbs:Arrangement ;
    rdf:value "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Notebooks were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.) for 131 notebooks, including four ledgers and eight travel journals. Upton has given this notebook an accession number, N-128, related to the series he created for the notebooks, probably following Herzfeld's original organization." ;
    mbs:noteType mbs:Arrangement .

kg:note_ref30019_odd_0 a crm:E33_Linguistic_Object ;
