kg:component_ref8114 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-22: Catalogue of 112 cylinder seals with rough sketches, Inventory numbers and references to drawings in sketchbooks" ;
