kg:component_ref8590 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-111: (CIA Damaskus)" ;
    dct:identifier "FSA A.6 03.111" ;
    crm:P102_has_title kg:title_ref8590 ;
    crm:P129_is_about kg:concept_aat_300263552,
        kg:concept_art_of_the_islamic_world,
        kg:concept_inscriptions_arabic,
        kg:concept_lcsh_sh85006507,
        kg:concept_lcsh_sh85066566 ;
    crm:P1_is_identified_by kg:title_ref8590 ;
    crm:P2_has_type aat:300027182,
        kg:concept_aat_300264354 ;
    crm:P3_has_note "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Notebooks were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.) for 131 notebooks, including four ledgers and eight travel journals. Upton has given this notebook an accession number, N-111, related to the series he created for the notebooks, probably following Herzfeld's original organization.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers Ernst Herzfeld Papers; N-111 FSA A.6 03.111",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-111 reads, \"(CIA Damaskus) Contains study notes on Arabic historical inscriptions in Damascus (a few in Hamah) (see also N-99). The folder also contains (1) corrected galley proofs of a text by van Berchem for a selection of von Oppenbeim's photographs of buildings in Damascus; (2) an outline in Herzfeld's writing of a method proposed for the publication of historical Arabic inscriptions in Syria (in this instance, the Jam'i Nuri in Hamah), based on van Berchem's system for the Corpus, with marginal comments by Sobernheim. (This was apparently a pre-cursor for the Aleppo volumes): and (3) miscellaneous inscriptions, including Damascus, Diarbekir and Gulpaigan.\"",
        "Scope and Contents Ernst Herzfeld Papers, Series 3: Notebooks; Notes and Sketches of Architectural Buildings and Inscriptions from Northern Syria (N-111)",
        "Scope and Contents note Contains study notes on Arabic historical inscriptions in Damascus (a few in Hamah) (see also N-99). The folder also contains (1) corrected galley proofs of a text by van Berchem for a selection of von Oppenbeim's photographs of buildings in Damascus; (2) an outline in Herzfeld's writing of a method proposed for the publication of historical Arabic inscriptions in Syria (in this instance, the Jam'i Nuri in Hamah), based on van Berchem's system for theCorpus, with marginal comments by Sobernhein. (This was apparently a pre-cursor for the Aleppo volumes): and (3) miscellaneous inscriptions, including Damascus, Diarbekir and Gulpaigan" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref8590 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref8590_arrangement_0,
        kg:note_ref8590_odd_0,
        kg:note_ref8590_odd_1,
        kg:note_ref8590_scopecontent_0,
        kg:note_ref8590_scopecontent_1,
        kg:note_ref8590_scopecontent_2,
        kg:place_damascus_syria,
        kg:place_tgn_1000004,
        kg:place_tgn_1000146 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.06/ref8590> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc31803d479-db6b-42ef-a03a-9e438f2ea47b> ;
    mbs:archivalLevel "file" ;
    mbs:digitizationKind mbs:none ;
    mbs:digitized false ;
    mbs:eadRef "ref8590" ;
    mbs:hasLinguisticObject kg:note_ref8590_arrangement_0,
        kg:note_ref8590_odd_0,
        kg:note_ref8590_odd_1,
        kg:note_ref8590_scopecontent_0,
        kg:note_ref8590_scopecontent_1,
        kg:note_ref8590_scopecontent_2 ;
    mbs:hasParentComponent kg:component_ref8055 ;
    mbs:hasPhysicalUnit kg:physical_ref8590 ;
    mbs:sovaUrl "https://sova.si.edu/record/fsa.a.06/ref8590"^^xsd:anyURI .

kg:component_ref8592 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:FileUnit ;
    rdfs:label "N-112: Notes for a study of \"Islamic Inscriptions from Iran,\" with a list of 218 inscriptions with cross-references to notebooks and sketchbooks." ;
    dct:identifier "FSA A.6 03.112" ;
    crm:P102_has_title kg:title_ref8592 ;
    crm:P129_is_about kg:concept_aat_300263552,
        kg:concept_art_of_the_islamic_world,
        kg:concept_inscriptions_arabic,
        kg:concept_lcsh_sh85006507,
        kg:concept_lcsh_sh85066566 ;
    crm:P1_is_identified_by kg:title_ref8592 ;
    crm:P2_has_type aat:300027182,
        kg:concept_aat_300026877,
        kg:concept_aat_300028094,
        kg:concept_aat_300127104,
        kg:concept_aat_300264354 ;
    crm:P3_has_note "Arrangement In the original arrangement of the Ernst Herzfeld Archive, Notebooks were included in a larger body of diverse material acknowledged by Ernst Herzfeld as his study collection. In the early 1970s, Joseph Upton, for research purpose, rearranged the collection and created a specific series (Ernst Herzfeld Papers, Series 3: Notebooks, 1904-1946, 1957, n.d.) for 131 notebooks, including four ledgers and eight travel journals. Upton has given this notebook an accession number, N-112, related to the series he created for the notebooks, probably following Herzfeld's original organization.",
        "General - Title is provided by Xavier Courouble, FSg Archives cataloger, based on Joseph Upton's Catalogue of the Herzfeld Archive.",
        "Local Numbers Ernst Herzfeld Papers; N-112 FSA A.6 03.112",
        "Scope and Contents - In Finding Aid, Joseph Upton's caption for N-112 reads, \"Notes for a study of \"Islamic Inscriptions from Iran,\" with a list of 218 inscriptions with cross-references to notebooks and sketchbooks. Folder also contains: (1) photo from A.U.Pope of inscription of Masjid-i Jam'i, Qazvin; (2) inscriptions from mosque and minaret at Barsian; and (3) unidentified tracings of Kufic inscriptions, possibly at Persepolis.\"",
        "Scope and Contents Ernst Herzfeld Papers, Series 3: Notebooks; Notes and Sketches of Arabic Inscriptions from Iran (N-112)",
        "Scope and Contents note Folder also contains: (1) photo from A.U.Pope of inscription of Masjid-i Jam'i, Qazvin; (2) inscriptions from mosque and minaret at Barsian; and (3) unidentified tracings of Kufic inscriptions, possibly at Persepolis" ;
    crm:P48_has_preferred_identifier kg:id_ark_ref8592 ;
    crm:P67_refers_to kg:agent_Q62933,
        kg:note_ref8592_arrangement_0,
        kg:note_ref8592_odd_0,
