        kg:note_ref10564_odd_1,
        kg:note_ref10564_scopecontent_0,
        kg:note_ref10564_scopecontent_1,
        kg:note_ref10564_scopecontent_2,
        kg:place_tgn_1000004,
        kg:place_tgn_7000231 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.04/ref10564> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3a0022306-0b50-47df-9b62-0c5f6d1f62e5> ;
