kg:note_ref9846_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"The Mas'udiyya building, built, most probably around 1860s by Imam Quli Mirza the son of Mohammad Ali Mirza. The building was destroyed in 1964 in order to open the Anahid stream and prepare the site as a Sassanid architecture landmark.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

