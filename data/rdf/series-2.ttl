        kg:place_tgn_7000231,
        kg:place_tgn_7014497 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.04/ref10117> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3bee5f8c9-8bb1-4539-bfac-da529b0116e1> ;
