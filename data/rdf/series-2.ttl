    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - Myron Bement Smith handwritten caption in English reads, \"47.P; Box 40.2: Isfahan. Pol-i Kaju. Lower side.\" [Myron Bement Smith Collection, Subseries 2.1: Islamic Archives History, Collection Information; Box 60; Folder 44: 47 P: Antoine Sevruguin, glass negatives, Iran]" ;
    mbs:noteType mbs:ScopeContent .

