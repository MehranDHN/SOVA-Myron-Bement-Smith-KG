kg:note_ref9749_bioghist_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Biographical / Historical" ;
    crm:P148_has_component kg:note_ref9749_bioghist_0_p_0 ;
    crm:P2_has_type mbs:BiogHist ;
    crm:P72_has_language lang:fre ;
    rdf:value "Biographical / Historical Félix Bonfils (1831 - 1885) was a French photographer and writer who was active in the Middle East. His family business \"Maison Bonfils,\" dominated Middle East commercial photography in the late 19th century." ;
    mbs:noteType mbs:BiogHist .

