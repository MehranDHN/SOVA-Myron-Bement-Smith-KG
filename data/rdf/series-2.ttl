    crm:P72_has_language lang:und ;
    rdf:value "Yahya Zoka and Mohammad Hassan Semsar, Tehran Dar Tasvir, Tehran: Sazman-i Miras-i Farhangi-i Kishvar, 1997, p:137-149" .

