    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Small touch up on the shoulders of the figure.\"" ;
    mbs:noteType mbs:ScopeContent .

