kg:component_ref10351 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Taq-i Bustan (Iran): Sasanian Rock Reliefs, Left Side of the Interior of the Large Vault with Investiture Relief of Khusro II: View of Relief Panel Picturing the Boar Hunt" ;
    dct:identifier "FSA A.4 2.12.GN.39.07" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref10351 ;
    crm:P129_is_about kg:concept_aat_300188750,
