kg:note_ref10357_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10357_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The bridge was reconstructed by Shah Abbas II in mid 17th century. Being a gathering spot for tourists and locals alike, the relative but striking emptiness of people from crowds leaves the view open for the capturing of the bridge's intricate brickwork and overall design. The front view allows for the continuity of water to the other side of the bridge to be visible.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

