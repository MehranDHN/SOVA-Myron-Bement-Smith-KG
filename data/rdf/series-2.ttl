kg:note_ref10437_arrangement_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Arrangement" ;
    crm:P148_has_component kg:note_ref10437_arrangement_0_p_0 ;
    crm:P2_has_type mbs:Arrangement ;
    crm:P72_has_language lang:und ;
    rdf:value "Arrangement According to Myron B. Smith handwritten document (Myron Bement Smith Collection, Subseries 2.1: Islamic Archives History, Collection Information; Box 60; Folder 44: 47 P Antoine Sevruguin, glass negatives, Iran), Antoin Sevruguin's 696 glass negatives, at the time of their acquisition, were arranged into 61 boxes without any apparent organization. Today they are housed in archival document boxes, essentially duplicating the original arrangement, and stored on shelves. This glass negative was included into \"Box 46.\"" ;
    mbs:noteType mbs:Arrangement .

