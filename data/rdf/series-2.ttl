kg:note_ref10103_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10103_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The image depicts Muzaffar al-Din Shah Qajar (b.1853-d.1906) on horseback and amongst a group of court attendants in Maydan-i Mashq. Maydan-i Mashq in Tehran was constructed during the reign of Fath Ali Shah Qajar and expanded and renovated during Nasir al-Din shah's reign and on the orders of Mirza Mohammad Khan Sipahsalar. The square was noted as the biggest one of its kind in Tehran.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

