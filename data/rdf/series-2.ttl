kg:note_ref9972_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9972_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The bowl is dated to Seljuq Period, approximately 12th- 13th century. It is attributed to Kashan, Iran as its place of origin. The bowl is currently in the Smithsonian's Freer|Sackler collection(1938.13). It is described as made of stone-paste, painted under clear glaze. The same bowl is shown in Neg.7.3 (FSA A.4 2.12.GN.07.03) and Neg. 11.3 (FSA A.4 2.12.GN.11.03).\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref9972_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9972_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"The glass negative is broken on thereby side with a big chunk missing. The measurements are taken of the longest part of the negative as it is today.\"" ;
    mbs:noteType mbs:ScopeContent .

