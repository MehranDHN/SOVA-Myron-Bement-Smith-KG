        kg:note_ref9964_odd_1,
        kg:note_ref9964_scopecontent_0,
        kg:note_ref9964_scopecontent_1,
        kg:note_ref9964_scopecontent_2,
        kg:note_ref9964_scopecontent_3,
        kg:place_tgn_1000004,
        kg:place_tgn_7000231,
        kg:place_tgn_7014497 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.04/ref9964> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc3759a286a-8d14-4d72-a49c-8eed771ae570> ;
    mbs:archivalLevel "item" ;
