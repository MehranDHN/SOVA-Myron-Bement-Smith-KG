    crm:P72_has_language lang:fre ;
    rdf:value "- On verso of the print, handwritten caption (penciled, probably by Antoin Sevruguin) in French reads, \"Avenue Alla es Douleh à Tehéran.\"" .

kg:note_ref9801_scopecontent_5_p_0 a crm:E33_Linguistic_Object ;
