kg:note_ref9903_odd_1 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref9903_odd_1_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    crm:P72_has_language lang:und ;
    rdf:value "General Title and summary note are provided by Shabnam Rahimi-Golkhandan, FSg curatorial research specialist." ;
    mbs:noteType mbs:OddNote .

kg:note_ref9903_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9903_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - \"By the second half of the twelfth century, the production of lustre-painted ceramics, an invention of potters in ninth-century Iraq, had been adopted in Iran. In Kashan, the principal city associated with lustreware, this tradition reached new levels of artistic and technical sophistication that were never equaled elsewhere.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref9903_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9903_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"This plate, regarded as one of the masterpieces of lustreware, is decorated with an highly unusual and complex composition. According to one interpretation it represents a mystical allegory in which a mystic, the sleeping youth, yearns to transcend the material world (signified by the horse) in order to reach a vision of divine beauty (symbolized by the naked woman floating in the fish pond) and union with God.\" [The Arthur M. Sackler Gallery and the Freer Gallery of Art]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref9903_scopecontent_2 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9903_scopecontent_2_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - On verso of the print (lower left corner), original stamp, in French and Persian, reads, \"Photographie Sevruguin.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref9903_scopecontent_3 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9903_scopecontent_3_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - On verso of the print, Myron Bement Smith caption in English reads, \"[lustre dish, Prince Khusraw discovers Shirin bathing. Signed ʿSayyid Shaws ad-Din al Hasaniʼ. Kashan, c. 1210. plate 65. Islamic art, by David Talbot Rice.].\"" ;
    mbs:noteType mbs:ScopeContent .

