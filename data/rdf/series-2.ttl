    crm:P148_has_component kg:note_ref10194_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Traces of varnish around both figures' faces.\"" ;
    mbs:noteType mbs:ScopeContent .

