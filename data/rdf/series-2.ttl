kg:component_ref10607 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Rayy (Iran): Zoroastrian Tower of Silence (Khamushan Tower)" ;
    dct:identifier "FSA A.4 2.12.GN.61.09" ;
