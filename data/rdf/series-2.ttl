    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"A large spot of varnish? Is on the top left side of the images that turns the whole negative brown. Slight coloring on the glasses of Nasir.\"" ;
    mbs:noteType mbs:ScopeContent .

