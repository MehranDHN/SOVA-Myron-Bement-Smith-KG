kg:note_ref10390_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"Born in 1848, Mukhbir al-Dawla was appointed as the minister of Post and Telegraph in 1897 when he took over his father's post after his death and he stayed in this position - with a 3 year absence from 1910-1913 - for the next 15 years.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

