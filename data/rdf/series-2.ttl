kg:note_ref10071_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"The sign on the wall reads Maydan-i Sipah. The uniform of the guard and the soldier in the mid-ground of the image suggests early Pahlavi period.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

