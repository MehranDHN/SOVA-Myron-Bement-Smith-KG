kg:note_ref9948_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9948_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The image is of the entrance to the Shah Jahan's Jami Mosque in New Delhi. The image stands alone in Sevruguin's collection since there are no other images of the same site or of India. The negative therefore could have been acquired by Sevruguin Studio or might have been mixed up with his collection in Pahlavi's confiscation of the collection.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

