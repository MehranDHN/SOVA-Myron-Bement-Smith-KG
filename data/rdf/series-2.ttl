kg:note_ref10201_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"The tower is attributed to Seljuk times. Myron Bement Smith refers to it in his own photographic archives (Box 82 of 250). In his description of the photo however, he mentions there are no numbers on it. The negative has a scratched number. The note is date to June of 1936. The image does not appear to have a number in the publication.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

kg:note_ref10201_scopecontent_1_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Red ink covers the sky all the way down to the edges of the structure.\"" .

