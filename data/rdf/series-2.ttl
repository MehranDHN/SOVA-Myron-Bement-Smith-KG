    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"There is red paper stuck to the area around the structure and black and red paint covers the area between the paper and the structure. Two figures standing in front of the structure are also painted over with black ink.\"" ;
    mbs:noteType mbs:ScopeContent .

