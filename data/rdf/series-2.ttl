    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The sky is reddened all the way down to the tree branches.\"" ;
    mbs:noteType mbs:ScopeContent .

