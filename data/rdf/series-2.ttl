kg:note_ref10122_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10122_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The name of the street was changed to Firdausi Avenue in 1933 and upon the conclusion of the Millennia of Firdausi ceremonies in Mashhad. Antoin Sevruguin's studio was also located in this street, along with the British consulate. The wall in the image might be the outer walls of the British Consulate. The photo seems to have been taken before the bombing of Sevruguin's neighbour during the events of the constitutional revolution of 1908.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10122_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10122_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"Thin lines on all four sides, probably where he wanted to cut the glass. The edges are all rough.\"" ;
    mbs:noteType mbs:ScopeContent .

