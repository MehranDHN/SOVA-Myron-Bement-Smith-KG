kg:note_ref10108_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10108_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The bank was established as a result of Iran's agreement with Julius De Reuter in 1889. The building in this picture was replaced by the new structure in Square of Canons in 1889. Though the bank operated inside Iran, it was under the British rules and regulations. Until 1894, the bank was the sole authority for publishing money notes in Iran.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10108_scopecontent_1 a crm:E33_Linguistic_Object ;
