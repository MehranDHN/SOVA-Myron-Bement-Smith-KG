    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - Myron Bement Smith handwritten caption in English reads, \"47.P; Box 31.6: Tehran. Celebration of May Day at Russian Embassy. 1926 or 1927.\" [Myron Bement Smith Collection, Subseries 2.1: Islamic Archives History, Collection Information; Box 60; Folder 44: 47 P: Antoine Sevruguin, glass negatives, Iran]" ;
    mbs:noteType mbs:ScopeContent .

