kg:note_ref10514_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10514_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"General view of the Qame-Zani ritual. The man in white attire are mourning the death of Hussayn, the 3rd Imam of Shi'i, by re-enacting and re-experiencing his pain. At the end of the ceremony the white dress would be covered in red blood stains.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

