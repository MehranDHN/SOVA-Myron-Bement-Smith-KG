    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"The glass negative is broken with portion of the upper right side missing.\"" ;
    mbs:noteType mbs:ScopeContent .

