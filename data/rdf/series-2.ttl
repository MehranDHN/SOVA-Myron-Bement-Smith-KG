kg:note_ref10294_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10294_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The photo is of a stone-paste dish painted over glaze with luster, attributed to Kashan (Iran) of 1210 and in the Seljuq period. One of the inscriptions records that the plate was made by Shamsuddin al-Hasani Abu Zayd, an accomplished potter of the early thirteenth century. It is currently in collection of Freer|Sackler, the Smithsonian's museums of Asian art (F1941.11).\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

