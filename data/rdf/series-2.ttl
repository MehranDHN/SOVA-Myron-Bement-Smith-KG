kg:component_ref10103 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Tehran (Iran): Muzaffar Al-Din Shah in Maydan-i Mashq" ;
    dct:identifier "FSA A.4 2.12.GN.16.07" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref10103 ;
    crm:P129_is_about kg:concept_aat_300188750,
        kg:concept_lcsh_sh00002542,
