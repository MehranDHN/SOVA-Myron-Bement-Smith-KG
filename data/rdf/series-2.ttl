kg:note_ref7496_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref7496_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
