kg:note_ref10168_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"The man sitting in the window-opening is Muhammad Hussayn Mirza Mir Akhur, Yamin al-Sultan. Yamin al-Sultan died in 1904. He was given the tile of Yamin al-Sultan in 1896 and he was appointed to his position as the chief of Royal stable (Mir Akhur) in 1884.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

