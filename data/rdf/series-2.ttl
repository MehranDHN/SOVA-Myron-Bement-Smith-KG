kg:note_ref10548_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"Persepolis, One of the north entrance doorways to Talar-i Takht (Throne hall, or Sad-Sutun) or One hundred column hall. The king appears immediately below the top section depicting Ahura Mazda with his guards and facing towards the interior of the hall.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

