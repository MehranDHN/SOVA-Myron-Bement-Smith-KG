kg:note_ref10185_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"The photograph is of a painting signed 'M.A.K', '1923', 'Tehran'. Not much is known about the artist, Pavel Petrovich Ivanov (b.1891-d.1967), except for the fact that he had lived in Iran for a short period between 1922 and 1925, practiced a style inspired by miniature painting and then immigrated to Belgium where he lived and worked for the rest of his life.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

kg:note_ref10185_scopecontent_1_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"There is black paper stuck to the emulsion side of the negative on all four sides of the image.\"" .

