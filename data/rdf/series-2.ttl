    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The image - a copy print of another photograph - should have been taken during the earlier days of Pahlavi. The military attire and hats can be dated to around 1920s.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

