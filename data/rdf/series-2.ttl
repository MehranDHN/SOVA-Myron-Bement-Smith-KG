    crm:P148_has_component kg:note_ref10082_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The sky is reddened all the way down to the mountain range.\"" ;
    mbs:noteType mbs:ScopeContent .

