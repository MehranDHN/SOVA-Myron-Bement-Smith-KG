    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Most probably a patch of varnish on the face and the chador under the chin.\"" ;
    mbs:noteType mbs:ScopeContent .

