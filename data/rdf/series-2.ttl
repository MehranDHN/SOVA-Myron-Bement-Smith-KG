kg:component_ref9047 a crm:E73_Information_Object,
        mbs:ArchivalComponent ;
    rdfs:label "Antoin Sevruguin Photographs" ;
    dct:identifier "2.12" ;
    crm:P102_has_title kg:title_ref9047 ;
    crm:P106_is_composed_of kg:component_ref9221,
        kg:component_ref9222,
        kg:component_ref9223 ;
    crm:P129_is_about kg:concept_aat_300007391,
        kg:concept_aat_300015524,
        kg:concept_aat_300188750,
        kg:concept_aat_300263552,
        kg:concept_ancient_near_eastern_art,
        kg:concept_art_of_the_islamic_world,
        kg:concept_lcsh_sh85000061,
