kg:note_ref9918_odd_1 a crm:E33_Linguistic_Object ;
    rdfs:label "General" ;
    crm:P148_has_component kg:note_ref9918_odd_1_p_0 ;
    crm:P2_has_type mbs:OddNote ;
    crm:P72_has_language lang:und ;
    rdf:value "General Title and summary note are provided by Shabnam Rahimi-Golkhandan, FSg curatorial research specialist." ;
