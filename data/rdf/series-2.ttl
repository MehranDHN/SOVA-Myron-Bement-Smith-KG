kg:component_ref10260 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Persepolis (Iran): Gate of All Lands, Colossal Sculptures Depicting Man-Bull (Sevruguin in White Coat)" ;
