    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The background of the figures is covered in red ink. It is probably a copy print.\"" ;
    mbs:noteType mbs:ScopeContent .

