kg:note_ref10063_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10063_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The photo depicts Nasir al-Din Shah standing in the mountainous region of Shimiran, north of Tehran. The Shimiran waterfall was one of the favorite leisure destinations of the Qajar king close to the city of Tehran. Nasir al-Din Shah's velvet covered short seat is at his foot and four of his attendants are in the background of the image. While the king looks away from the camera into the distance the attendants engage the gaze of the camera and the viewer. The photo must have been taken in the later years of Nasir al-Din Shah's reign.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10063_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10063_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - Handwritten information on slip of paper (from a 1943-1944 cash book, produced by the Bathni Brothers, Tehran) reads, \"333) Nasr Din Shah at Abshar-Shimran. [Marked with unidentified seal].\" [Myron Bement Smith Collection, Subseries 2.1: Islamic Archives History, Collection Information]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10063_scopecontent_2 a crm:E33_Linguistic_Object ;
