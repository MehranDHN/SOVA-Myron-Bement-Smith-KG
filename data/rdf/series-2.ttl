kg:note_ref10230_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10230_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The sky is covered with brownish paper. The area between the paper and the horizon line is filled with black ink (on the emulsion side). On the lower half of the negative an imprint of what looks like ink around five columns of Persepolis - from another photograph of that scene - is visible, which is most probably due to the original storing of the two negatives on top of one another.\"" ;
    mbs:noteType mbs:ScopeContent .

