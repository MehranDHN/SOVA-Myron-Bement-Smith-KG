    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The sky is completely covered in red ink with brush marks very visible.\"" ;
    mbs:noteType mbs:ScopeContent .

