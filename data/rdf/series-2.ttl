        kg:component_ref8612,
        kg:component_ref8613,
        kg:component_ref8614 ;
    crm:P1_is_identified_by kg:title_ref8478 ;
    crm:P3_has_note "Scope and Contents note Myron Bement Smith (MBS) traveled and lectured in the Middle East, South Asia and Turkey in 1958 and 1960. The United States Information Service (USIS) sponsored most of this travel as part of its program of international education lectures. MBS took many slides of Islamic sites and monuments in the countries he visited. Most of these are general exterior shots of the sites and monuments not the meticulous architecturally detailed photography of his 1930s Iran photographs. The original slides taken by MBS were assigned the alphanumeric K plus a number." ;
    crm:P48_has_preferred_identifier kg:id_ark_ref8478 ;
    crm:P67_refers_to kg:agent_smith_myron_bement,
        kg:agent_united_states_information_service,
        kg:note_ref8478_scopecontent_0,
        kg:place_middle_east,
        kg:place_south_asia,
        kg:place_tgn_1000144 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.04/ref8478> ;
    owl:sameAs <https://n2t.net/ark:/65665/dc39c50dcd0-f229-47d1-85f3-1f158b3bff96> ;
    mbs:archivalLevel "subseries" ;
    mbs:digitizationKind mbs:none ;
    mbs:digitized false ;
    mbs:eadRef "ref8478" ;
    mbs:hasChildComponent kg:component_ref8480,
        kg:component_ref8481,
