    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Persepolis, One of the north entrance doorways to Talar-i Takht (Throne hall, or Sad-Sutun) or One hundred column hall. The king appears immediately below the top section depicting Ahura Mazda with his guards and facing towards the interior of the hall.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

