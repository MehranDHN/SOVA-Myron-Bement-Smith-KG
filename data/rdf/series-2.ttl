    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - Handwritten information on slip of paper (from a 1943-1944 cash book, produced by the Bathni Brothers, Tehran) reads, \"524-527) Pahlevi, new city.\" [Myron Bement Smith Collection, Subseries 2.1: Islamic Archives History, Collection Information]" ;
    mbs:noteType mbs:ScopeContent .

