    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"The glass negative has stains which might have been cause by water.\"" ;
    mbs:noteType mbs:ScopeContent .

