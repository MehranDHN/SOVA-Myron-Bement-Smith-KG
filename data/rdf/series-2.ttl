    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - Handwritten number in white (inked, probably by Antoin Sevruguin) reads, \"113.\"" ;
    mbs:noteType mbs:ScopeContent .

