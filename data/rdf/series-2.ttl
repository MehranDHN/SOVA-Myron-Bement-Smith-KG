    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The image seems to be a copy print of another photo.\"" ;
    mbs:noteType mbs:ScopeContent .

