kg:note_ref9846_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9846_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The Mas'udiyya building, built, most probably around 1860s by Imam Quli Mirza the son of Mohammad Ali Mirza. The building was destroyed in 1964 in order to open the Anahid stream and prepare the site as a Sassanid architecture landmark.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

