kg:note_ref10087_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"Talar-I Takht or Throne room of Gulistan palace housed the famous Peacock throne and was the offical reception room of the palace. The photo is taken from the middle of the room and in the opposite direction of the entrance, facing the throne at the far end. The room is depicted empty with only one attendant whose reflection is visible in the mirror to the left side the throne. The walls and tables on the either sides of the hallway are decorated with paintings and objects that could be the valuable gifts of the visitors to the Qajar court.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

kg:note_ref10087_scopecontent_1_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"The glass negative is chipped off on the right and the bottom sides.\"" .

