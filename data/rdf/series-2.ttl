    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The image appear to be a copy print of an older image.\"" ;
    mbs:noteType mbs:ScopeContent .

