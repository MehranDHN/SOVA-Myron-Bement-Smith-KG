    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The face is thoroughly touched up. There is varnish on the face as well.\"" ;
    mbs:noteType mbs:ScopeContent .

