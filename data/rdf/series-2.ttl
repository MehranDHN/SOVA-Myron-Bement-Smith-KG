kg:note_ref9954_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9954_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Portrait of the seated woman in velvet, wearing a pearl rope. The outline of the woman's face is visible under her sheer face cover. The pleated skirt of the woman indicates that the photo is produced most likely in the early 20th century. The composition and subject matter of the photo is different from other studio portraiture of women in Sevruguin's collection. The face of the figure is covered in this image and there is no trace of a background studio setting. The woman turns away from the camera, giving only a partial view of her profile.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

