kg:note_ref10082_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10082_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Nasir al-Din Shah is depicted in almost the centre of the image on horseback and under the umbrella. On the white horse on the king's right side Aziza al-Sultan can be seen on horseback. The king and his entourage are probably on their way to Dasht-I Lar, one of the usual hunting spots of Nasir al-Din Shah.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10082_scopecontent_1 a crm:E33_Linguistic_Object ;
