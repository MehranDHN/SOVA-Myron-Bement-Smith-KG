    crm:P148_has_component kg:note_ref10439_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Varnish on the face and very careful touch ups on the face.\"" ;
    mbs:noteType mbs:ScopeContent .

