    rdfs:label "Bishapur (Iran): Sasanian Reliefs Showing Bahram II Receiving a Delegation: Detail View of Delegation Bringing Horses and Camels to the King" ;
    dct:identifier "FSA A.4 2.12.GN.31.11" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref10261 ;
