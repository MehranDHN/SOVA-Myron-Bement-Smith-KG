    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10386_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Black ink covering the sky. (not for this negative: Brown paper attached to the back side throughout the skyline. The space between the paper and the line of horizon is filled out with ink that goes down all the way through to the three tops. A small piece of white paper is attached to the emulsion side covering part of the emulsion depicting the sky).\"" ;
    mbs:noteType mbs:ScopeContent .

