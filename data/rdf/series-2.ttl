kg:note_ref10286_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10286_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The sky is covered with green paper. The area between the paper and the structure is filled with black ink. The negative has a brownish yellow hue all over, The negative has been chopped off on top and the two sides. Traces of ink is visible on the top edge of the mountain range on the right.\"" ;
    mbs:noteType mbs:ScopeContent .

