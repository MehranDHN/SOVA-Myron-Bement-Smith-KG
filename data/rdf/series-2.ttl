kg:note_ref9952_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9952_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The photo is of a woman with chador and face-cover, with the white cloth of the face-cover partially removed to show the eyes and most of the nose. The studio portrait seems to have been produced on the orders of the patron as it differs from the other images of covered and uncovered women in the archive of Sevruguin images.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref9952_scopecontent_1 a crm:E33_Linguistic_Object ;
