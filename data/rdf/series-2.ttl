        kg:component_ref9230 ;
    crm:P1_is_identified_by kg:title_ref9221 ;
    crm:P3_has_note "Scope and Contents 695 glass negatives were included into the \"Islamic Archives,\" which was administered jontly by the committee for Islamic Culture and the committee for Arabic and Islamic Studies of the American Council of Learned Societies. According to the official minutes, the committee for Islamic Culture reported purchasing the 696 glass plates during their fiscal years 1951-1952 from the American Presbyterian Mission in Tehran. Antoin Sevruguin's daughter gave these plates to the mission with instruction that they be sold for the benefit of the mission. The glass negatives are numbered but without apparent organization." ;
    crm:P48_has_preferred_identifier kg:id_ark_ref9221 ;
    crm:P67_refers_to kg:note_ref9221_scopecontent_0 ;
    rdfs:seeAlso <https://sova.si.edu/record/fsa.a.04/ref9221> ;
