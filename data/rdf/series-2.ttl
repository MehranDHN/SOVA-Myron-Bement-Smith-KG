kg:component_ref9221 a crm:E73_Information_Object,
        mbs:ArchivalComponent ;
    rdfs:label "Glass Plate Negatives" ;
    dct:identifier "2.12.01" ;
    crm:P102_has_title kg:title_ref9221 ;
