    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Black paper on the front and back (one piece of paper folded over) and red ink on the front. Small piece of curved glass is stuck on the bottom one fourth of the negative on the back side. There are remnants of glue on the back paper which indicates that the small piece of glass was part of a bigger piece stuck under the negative that broke off at some point.\"" ;
    mbs:noteType mbs:ScopeContent .

