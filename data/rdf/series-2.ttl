    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"Remnants of brown varnish all over the negative.\"" ;
    mbs:noteType mbs:ScopeContent .

