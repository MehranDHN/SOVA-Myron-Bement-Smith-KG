    crm:P148_has_component kg:note_ref10461_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Behind the blurry imprint of a figure in the right side of the mid ground the photographer has remade the brick work at the bottom of the blind arch.\"" ;
    mbs:noteType mbs:ScopeContent .

