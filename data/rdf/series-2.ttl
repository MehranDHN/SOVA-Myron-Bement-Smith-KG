    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The photo depicts the tomb with a young boy sitting in the far end of the tunnel and in front of the entrance. The interior of this tomb is the most accessible amongst the six tomb structure of Sassanid empire.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10239_scopecontent_1 a crm:E33_Linguistic_Object ;
