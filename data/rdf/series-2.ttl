    crm:P72_has_language lang:und ;
    rdf:value "- On recto of the print, scratched handwritten number (inked, probably by Antoin Sevruguin) reads, \"131.\"" .

kg:note_ref9855_scopecontent_3_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- On verso of the print (lower left corner), original stamp, in French and Persian, reads, \"Photographie Sevruguin.\"" .

