    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The Structure is most probably a tomb dated to Seljuk times. The photo depicts the structure with two figures in western attire - a woman on the right and a man on the left - in front of it, facing the camera.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

