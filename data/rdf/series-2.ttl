    crm:P72_has_language lang:und ;
    rdf:value "- FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"The glass negative is broken on thereby side with a big chunk missing. The measurements are taken of the longest part of the negative as it is today.\"" .

