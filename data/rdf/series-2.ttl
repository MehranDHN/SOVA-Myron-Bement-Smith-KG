    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"Most probably a copy print. On the lower left edge of the negative there is a small rectangle of lighter area that has very faint traces of a text line running through it.\"" ;
    mbs:noteType mbs:ScopeContent .

