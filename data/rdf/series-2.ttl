    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The investiture of Khusrow Parviz depicted on the top section and Khusrow II is depicted on horse back and in full armor in the lower section. The graffiti on this image is faded. It might have been taken on a later date.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

