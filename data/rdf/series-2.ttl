    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Two thin lines on the bottom and the right side of the negative. The two sides are intentionally broken.\"" ;
    mbs:noteType mbs:ScopeContent .

