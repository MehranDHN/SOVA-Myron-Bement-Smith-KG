kg:note_ref10256_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10256_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"A layer of varnish covers the area where people are seated. Some the people's faces are also touched up. The touch ups are visible through the layer of varnish.\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10256_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10256_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - Handwritten information on slip of paper (from a 1943-1944 cash book, produced by the Bathni Brothers, Tehran) reads, \"17) Celebration of May Day at Russian Embassy in Teheran in 1926 or 1927. Beard in front row is the droshka driver of the Czarist ambassador. 2nd on right hand (as appears in negative) of Beard is director of Russian Bank. 3rd is interpreter or clerk. 4th is Russian consul Pleyst. end on left hand (as appears in engative) is Russian ambassador (Yurienev).\" [Myron Bement Smith Collection, Subseries 2.1: Islamic Archives History, Collection Information]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10256_scopecontent_2 a crm:E33_Linguistic_Object ;
