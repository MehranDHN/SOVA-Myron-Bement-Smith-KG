kg:component_ref9854 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Vicinity of Hamadan (Iran): Sassanid Inscriptions of Ganj-Nama" ;
    dct:identifier "FSA A.4 2.12.Sm.39" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref9854 ;
    crm:P129_is_about kg:concept_ancient_near_eastern_art,
        kg:concept_cuneiform_inscriptions,
