    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Built in mid 14th century on the road to Mashhad, the tomb houses a Mihrab inside. The photograph is the view towards north and from the southern façade of the structure.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

