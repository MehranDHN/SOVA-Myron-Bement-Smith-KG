kg:note_ref10248_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"The Structure is most probably a tomb dated to Seljuk times. The photo depicts the structure with two figures in western attire - a woman on the right and a man on the left - in front of it, facing the camera.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

