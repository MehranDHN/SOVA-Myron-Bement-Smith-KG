kg:note_ref9854_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"A Bakhtiari guard posing beside the Sassanid inscriptions of Ganj-nama (in Cuneiform), located close to the city of Hamadan. The two inscriptions were most probably ordered by Darius I and Xerxes I.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

kg:note_ref9854_scopecontent_1_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- On recto of the print, handwritten number (inked, probably by Antoin Sevruguin) reads, \"12.\"" .

kg:note_ref9854_scopecontent_2_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- On recto of the print, faded handwritten number (inked, probably by Antoin Sevruguin) reads, \"587.\"" .

kg:note_ref9854_scopecontent_3_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- On verso of the print, handwritten number (penciled) reads, \"47.9.\"" .

kg:note_ref9854_scopecontent_4_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- On verso of the print (lower left corner), original stamp, in French and Persian, reads, \"Photographie Sevruguin.\"" .

kg:note_ref9854_scopecontent_5_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "- On verso of the print, Myron Bement Smith caption in English reads, \"Persia; Hamadān; Gang Nameh [Ganj Nameh]; Curzon i., 566: Trilingual inscriptions relating names and titles of Darius, first due to interpretation of cuneiform in mountain range of Mount Girend near Hamadan.\"" .

