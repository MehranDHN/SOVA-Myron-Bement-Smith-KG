kg:note_ref9816_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9816_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The photograph depicts a group of men and children around an ice cream vendor in what looks to be the Maydan-I Mashq in Tehran. The shorter hat of the man in coat on the left side of the image puts the date around the later years of Nasir al-Din Shah's reign.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

