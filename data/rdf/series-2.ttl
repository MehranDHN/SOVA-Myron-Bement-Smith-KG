kg:component_ref10148 a crm:E73_Information_Object,
        mbs:ArchivalComponent,
        mbs:ItemUnit ;
    rdfs:label "Studio Portrait: Seated Persian Girl in Ballet Costume" ;
    dct:identifier "FSA A.4 2.12.GN.21.04" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref10148 ;
    crm:P129_is_about kg:concept_aat_300015524,
