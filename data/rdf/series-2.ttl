kg:note_ref10598_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10598_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Also known as Nusrat al-Mulk, Mu'iz al-Saltana, Sardar Arfa' and Sardar Aqdas, he was the governor of Khuzestan form 1898 for around thirty years. Shaykh Khaz'al entered into an agreement with the British government at the beginning of the World War I, upon which the British government agreed to protect the sovereignty of Khaz'al's rule against any government - including the central government of Iran. After the war and a following unsuccessful attempt at establishing a sovereign Arab state in Khuzestan, he was arrested and brought to Tehran in 1926 where he stayed until his death/murder on May 25th of 1936.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10598_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10598_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Black paper on the front. Black ink in between the paper and the figure. Pencil marks on the face. Small yellowish piece of paper on the bottom left.\"" ;
    mbs:noteType mbs:ScopeContent .

