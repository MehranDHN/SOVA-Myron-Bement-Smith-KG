kg:note_ref9895_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9895_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The bridge is the subject matter of the photo which has been taken from a position that allows for the whole structure to fir in the boundaries of the image. The figures on top of the bridge bring a sense of scale to the image. On top of the bridge there are two shadows in the same spot. There are of the same person moving. The same can be said about the shadow on the foot of the bridge.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

