kg:note_ref10208_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10208_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Note the bust on the shelf and the photos on the background wall are of Lenin. The writing on the background wall hails Lenin as well. It is possible that the abundance of references to Lenin are a product of his death in 1924.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

