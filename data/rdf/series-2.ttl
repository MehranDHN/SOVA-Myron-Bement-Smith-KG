    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The face has extensive and very careful markings and touch ups.\"" ;
    mbs:noteType mbs:ScopeContent .

