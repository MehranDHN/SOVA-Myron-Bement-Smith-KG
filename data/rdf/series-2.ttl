kg:note_ref9922_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9922_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The photograph is a copy print of another image, by a studio called 'A. Ken Phot[o]' which is inscribed at the bottom left side of the image. A. Ken Phot was the official signature of a photographic studio on 10 Montmartre Blvd. in Paris, owned and operated by Alexander Ken (1831-1874). The man in the image has a medal that resembles 'Nishan-i Aftab' created by Nasir al-Din Shah Qajar.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

