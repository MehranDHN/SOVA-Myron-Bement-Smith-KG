        kg:note_ref10117_bioghist_0,
        kg:note_ref10117_odd_0,
        kg:note_ref10117_odd_1,
        kg:note_ref10117_scopecontent_0,
        kg:note_ref10117_scopecontent_1,
        kg:note_ref10117_scopecontent_2,
