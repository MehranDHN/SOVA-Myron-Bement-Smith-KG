kg:note_ref10615_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10615_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:eng ;
    rdf:value "Scope and Contents - Information from Archives staff reads, \"266 handwritten identifications on slips of paper (from a 1943-1944 cash book, produced by the Bathni Brothers, Tehran).\"" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10615_scopecontent_1 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10615_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:eng ;
    rdf:value "Scope and Contents - Additional information from initial Sevruguin Finding Aid reads, \"Handwritten identifications recorded on scraps of paper were housed with nearly 300 photonegatives in this collection.\"" ;
    mbs:noteType mbs:ScopeContent .

