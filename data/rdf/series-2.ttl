    rdfs:label "Shahr-i Ray (Iran): North side of Naqar Khana, Tomb Tower" ;
    dct:identifier "FSA A.4 2.12.GN.26.08" ;
    dct:language "und" ;
    crm:P102_has_title kg:title_ref10201 ;
    crm:P129_is_about kg:concept_aat_300263552,
        kg:work_early_photography_of_iran ;
