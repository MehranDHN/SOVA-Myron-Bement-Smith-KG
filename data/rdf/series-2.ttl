    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"On the far left of the image traces of another land strip can be seen. Therefore the photo is from the coast of a river. There are other images of the same kind of small vessels on Karun river.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

