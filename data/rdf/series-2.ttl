kg:note_ref10258_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10258_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The minaret, a distinctly Seljuk structure, was built around 1080 and is located on the northeast corner of the mosque. The diameter of the base of the minaret measure close to 14 meters gradually reducing as it rises twenty-seven meters off the ground to reach seven meters in diameter at the top. The three-iwan mosque has gone under extensive renovations in the later (Nasiri) Qajar period.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

kg:note_ref10258_scopecontent_1 a crm:E33_Linguistic_Object ;
