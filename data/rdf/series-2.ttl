kg:note_ref9946_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"The image - a copy print of another photograph - should have been taken during the earlier days of Pahlavi. The military attire and hats can be dated to around 1920s.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

