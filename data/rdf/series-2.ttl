kg:note_ref10220_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10220_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The villa was built on the south side the Gulistan Palace complex on the orders of Fath Ali Shah Qajar. Later on and on the orders of Nasir al-Din Shah extensive renovations were carried out on the site and the renovations continued later in the early Pahlavi era as well. The building is currently undergoing fresh rounds of renovations. The photo depicts the structure from the far end of the front pool, carefully framing the structure in the centre of the image. The complete symmetry of the plans allows for such symmetry in the image.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

