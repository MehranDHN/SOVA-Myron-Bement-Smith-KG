    crm:P148_has_component kg:note_ref10258_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"The sky is covered with red paper. The area between the paper and the horizon line is filled with black ink.\"" ;
    mbs:noteType mbs:ScopeContent .

