kg:note_ref10207_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10207_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Hassan Ali Khan Garusi or Amir Nizam was born in 1822 and from 1838 till his death in 1899 occupied numerous official positions in Qajar court. He was one of the most influential politicians of the Qajar court. The photo is most probably taken in the last years of his life.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

