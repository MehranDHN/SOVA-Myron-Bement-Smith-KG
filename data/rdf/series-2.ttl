    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"All four sides are chopped. Ink spots all over the image covering imperfections and scratches.\"" ;
    mbs:noteType mbs:ScopeContent .

