    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo condition reads, \"The glass negative is chipped off on the right edge both on the side and the top.\"" ;
    mbs:noteType mbs:ScopeContent .

