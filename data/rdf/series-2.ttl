kg:note_ref10400_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10400_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Mahd-i Awliya, Nasir al-Din Shah's mother is depicted in this photograph. The negative is a copy of another photograph. Since Mahd-I Awliya passed away in Tehran in 1873 and there are no account of Sevruguin being active in Iran in that period, it is safe to assume that the photo in the Sevruguin archive was taken off of another one, possibly taken by Nasir al-Din shah himself.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

