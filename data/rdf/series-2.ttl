    crm:P148_has_component kg:note_ref10524_scopecontent_1_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"All of the faces are touched up with with very sharp pencil.\"" ;
    mbs:noteType mbs:ScopeContent .

