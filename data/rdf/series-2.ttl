kg:note_ref9867_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref9867_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The photo depicts a crowd in the courtyard of Gawharshad mosque in Mashhad. The Timurid structure was orderd by Gawharshad Agha, Timurid king Shahrukh's wife, and built in 1418. The architect of the building is known as Ustad Ghavam al-Din Shirazi.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

