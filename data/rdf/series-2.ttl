    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Red ink covers the sky all the way down to the edges of the structure.\"" ;
    mbs:noteType mbs:ScopeContent .

