kg:note_ref10252_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"Persepolis, general view of Darvaza-i Millal (Gate of All Nations) or Gate of Xerxes, with guardian man-bulls of eastern doorway. The photo is taken prior to the completion of the excavations as the base of the columns and the lower part of the entrance gate pillars are still hidden from the view.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

