    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"A thin piece of black paper is attached to the borders of the image. The exposed glass negative is glued to another empty piece of glass.\"" ;
    mbs:noteType mbs:ScopeContent .

