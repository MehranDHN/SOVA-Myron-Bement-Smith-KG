kg:note_ref10507_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10507_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The street front and the shops' windows looks similar to a photo of Sevruguin's own studio, which substantiates the claim that this is Ala al-Dawla street. Note that in 1313/1923, the name of the street was changed to Firdawsi to commemorate both the poet and the ceremonies of his Millennia.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

