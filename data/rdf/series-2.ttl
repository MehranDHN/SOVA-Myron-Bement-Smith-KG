kg:note_ref10450_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"A Bakhtiari guard posing beside the Sassanid inscriptions of Ganj-nama (in Cuneiform), located close to the city of Hamadan. The two inscriptions were most probably ordered by Darius I and Xerxes I.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

