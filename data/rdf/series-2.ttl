kg:note_ref10158_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10158_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"Zurkhana wrestlers are depicted warming up to perform in front of the large crowd of spectators (partly visible) and possibly the king and his attendants. The camera's point of view - slightly elevated and above the main platform of performances - places the photographer on the balcony of the palace's entrance and close to the Royal seating place.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

