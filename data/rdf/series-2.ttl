    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents - FSg curatorial research specialist remark on Antoin Sevruguin photo manipulation reads, \"Black paper on the back. Red ink between the paper and the figure.\"" ;
    mbs:noteType mbs:ScopeContent .

