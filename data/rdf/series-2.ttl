kg:note_ref10202_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"Built in mid 14th century on the road to Mashhad, the tomb houses a Mihrab inside. The photograph is the view towards north and from the southern façade of the structure.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

