    crm:P72_has_language lang:und ;
    rdf:value "- Scratched handwritten number (inked, probably by Antoin Sevruguin) not readable." .

kg:note_ref10246_scopecontent_4_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
