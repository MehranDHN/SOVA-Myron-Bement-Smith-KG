kg:note_ref9917_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"A woman and a man are shown sitting on the base of the relief. Another man is leaning against the relief in the lower left corner. The relief depicts Shapur fighting with Valerian. The photo is from an angle and it depicts the lower half of the structure.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

