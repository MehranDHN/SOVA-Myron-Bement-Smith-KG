kg:note_ref10471_scopecontent_0_p_0 a crm:E33_Linguistic_Object ;
    crm:P72_has_language lang:und ;
    rdf:value "\"Zahir al-Dawla is depicted in the attire of Ishaq Aghasi Bashi. Ishiq Aghasi Bashi was the official title of the chief justice of the city or the head of the royal court.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" .

