kg:note_ref10174_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10174_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The city hall is located in the north wing of the Tupkhana square (Maydan-i Tupkhana). The new Canons' square and the two storey buildings surrounding it were built between 1867 and 1877 on the north side of the old Canons' square or Maydan-i Arg. The two-storey building in the background of the image surrounding the square was initially planned as a reservoir of military equipment and a meeting and living place of military officials.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

