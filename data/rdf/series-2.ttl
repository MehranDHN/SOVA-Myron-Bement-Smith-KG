kg:note_ref10391_scopecontent_0 a crm:E33_Linguistic_Object ;
    rdfs:label "Scope and Contents" ;
    crm:P148_has_component kg:note_ref10391_scopecontent_0_p_0 ;
    crm:P2_has_type mbs:ScopeContent ;
    crm:P72_has_language lang:und ;
    rdf:value "Scope and Contents \"The Madrasa/mosque complex was built in 1866 on the orders of Mirza Mohammad Khan (Sipahsalar) (d.1867), Nasir al-Din shah's minister of the army and later chief minister. The complex includes also a library, bath, and hospital. The clock on the entrance of the square is showing 8:30 in the morning. The men in the gateway Iwan are, however, praying. The shadows also indicate sometime in the afternoon.\" [Freer Gallery of Art and Arthur M. Sackler Gallery Archives, Curatorial Research Assistant]" ;
    mbs:noteType mbs:ScopeContent .

