# Q19 — Scope notes as E33 linguistic objects hanging off a component.
PREFIX mbs:  <https://w3id.org/sova/fsa_a_04/ontology#>
PREFIX crm:  <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?component ?title ?note ?text
WHERE {
  ?component a mbs:ArchivalComponent ;
             rdfs:label ?title ;
             mbs:hasLinguisticObject ?note .
  ?note a crm:E33_Linguistic_Object ;
        mbs:noteType mbs:ScopeContent .
  OPTIONAL { ?note rdf:value ?text }
}
LIMIT 40
